' ==========================================================================
' LongPathOracle
'
' One question: does the REAL Scripting.FileSystemObject handle paths longer
' than the legacy 260-char MAX_PATH? Check this before deciding whether
' tbFileSysTools needs to match, exceed, or deliberately not bother.
'
' The tree is built by cmd's "md" with a \\?\ prefix (which lifts the 260 cap),
' NOT by the tB library - our own CreateFolder is 260-capped, so it cannot build
' the fixture. Existence is checked with GetFileAttributesW on a \\?\ path for the
' same reason. Only once a genuine >260 leaf exists do we ask FSO to touch it.
'
' Nothing here asserts pass/fail - it PRINTS what FSO does, because the point is
' to discover behaviour, not check a known answer. Read the output.
'
' The tB library is probed too, on the same leaf, so OUR limit and FSO's limit
' are reported side by side and can't be confused.
' ==========================================================================

' https://learn.microsoft.com/en-us/windows/win32/fileio/maximum-file-path-limitation?tabs=registry
'<application xmlns="urn:schemas-microsoft-com:asm.v3">
'<windowsSettings xmlns:ws2="http://schemas.microsoft.com/SMI/2016/WindowsSettings">
'    <ws2:longPathAware>true</ws2:longPathAware>
'</windowsSettings>
'</application>

Private Module LongPathOracle
    Option Explicit

    Private Const SEG As String = "seg_0123456789_abcdefghijkl"   ' 27 chars
    Private Const DEPTH As Long = 12                              ' 12 * ~29 = >340 chars past base

    Public Sub Run()
        Dim fso As Object
        Dim sh As Object
        Dim base As String, deep As String, leaf As String
        Dim i As Long
        Dim r As String

        Set fso = CreateObject("Scripting.FileSystemObject")
        Set sh = CreateObject("WScript.Shell")

        base = FileSystemTools.BuildPath(FileSystemTools.GetSpecialFolder(sfTemporaryFolder), "longpath")

        Debug.Print "=== Long-path oracle (FSO vs >260 chars) ==="
        Debug.Print "  MAX_PATH (legacy) = 260"

        On Error GoTo Fatal

        ' --- Build the full deep path STRING (no disk yet) ------------------
        deep = base
        For i = 1 To DEPTH
            deep = FileSystemTools.BuildPath(deep, SEG & Right$("00" & i, 2))
        Next i
        Debug.Print "  Planned depth string = " & Len(deep) & " chars"

        ' --- Create the tree via cmd, past the 260 cap, using \\?\ ---------
        ' rd first (ignore failure) so a leftover tree from a prior run is gone.
        sh.Run "cmd /c rd /s /q ""\\?\" & base & """", 0, True
        sh.Run "cmd /c md ""\\?\" & deep & """", 0, True         ' md creates all missing levels
        If Not LongFolderExists(deep) Then
            Debug.Print "  cmd could not build the >260 tree (len " & Len(deep) & "). Stopping."
            Debug.Print "  -> cmd/md is not long-path capable on this box; would need rung-by-rung mkdir."
            GoTo CleanUp
        End If
        Debug.Print "  Built " & Len(deep) & "-char tree via cmd (\\?\)."

        leaf = FileSystemTools.BuildPath(deep, "the_target_file.txt")
        Debug.Print "  Leaf path length  = " & Len(leaf) & _
                    IIf(Len(leaf) > 260, "   (>260 - good)", "   (NOT >260 - increase DEPTH)")
        Debug.Print "  Leaf: " & leaf
        Debug.Print ""

        ' --- Seed the leaf via cmd (echo > \\?\path), NOT via tB or FSO ----
        ' We need content in the leaf before probing readers, and the writer used to
        ' place it must not itself be 260-capped - so cmd does it.
        sh.Run "cmd /c echo hello from a long path>""\\?\" & leaf & """", 0, True
        If Not LongFileExists(leaf) Then
            Debug.Print "  cmd could not write the leaf file. Continuing (readers will fail)."
        Else
            Debug.Print "  Seeded the leaf file via cmd."
        End If
        Debug.Print ""

        ' --- What does OUR library do with the >260 leaf? ------------------
        Debug.Print "  --- tbFileSysTools on the >260 leaf ---"

        On Error Resume Next
        r = CStr(FileSystemTools.FileExists(leaf))
        ReportProbe "tB FileExists", Err.Number, Err.Description, r
        On Error GoTo Fatal
        
        r = CStr(FileSystemTools.GetFileEncoding(leaf))
        ReportProbe "tB GetFileEncoding", Err.Number, Err.Description, r
        On Error GoTo Fatal
        
        r = CStr(FileSystemTools.GetFileName(FileSystemTools.GetAbsolutePathName(leaf)))
        ReportProbe "tB GetfileName/GetAbsolutePathName", Err.Number, Err.Description, r
        On Error GoTo Fatal
        
        Dim cd As String
        cd = FileSystemTools.GetCurrentDir()

        On Error Resume Next
        FileSystemTools.SetCurrentDir FileSystemTools.GetParentFolderName(leaf)
        'ChDir FileSystemTools.GetParentFolderName(leaf)
        Dim e As Long, d As String
        e = Err.Number: d = Err.Description        ' capture BEFORE anything else runs
        On Error GoTo Fatal

        r = FileSystemTools.GetCurrentDir()
        ReportProbe "tB SetCurrentDir", e, d, r
        Debug.Print "      (CWD unchanged = " & CStr(StrComp(r, cd, vbTextCompare) = 0) & _
                    " - expected True: a >260 CWD is impossible on Windows)"

        On Error Resume Next
        FileSystemTools.SetCurrentDir cd            ' restore
        On Error GoTo Fatal

        On Error Resume Next
        r = CStr(FileSystemTools.GetFile(leaf).Size)
        ReportProbe "tB GetFile.Size", Err.Number, Err.Description, r
        On Error GoTo Fatal

        On Error Resume Next
        r = FileSystemTools.TextFileToString(leaf)
        ReportProbe "tB ReadText", Err.Number, Err.Description, Trim$(r)
        On Error GoTo Fatal
        
        On Error Resume Next
        r = FileSystemTools.OpenTextFile(leaf).ReadAll()
        ReportProbe "tB OpenTextFile", Err.Number, Err.Description, Trim$(r)
        On Error GoTo Fatal
        
        On Error Resume Next
        r = FileSystemTools.Rename(leaf, "renamed_target_file.txt")
        ReportProbe "tB Rename", Err.Number, Err.Description, Trim$(FileSystemTools.GetFileName(r))
        On Error GoTo Fatal
        FileSystemTools.Rename r, leaf
        Debug.Print ""
        

        ' --- What does the REAL FSO do with the same leaf? ----------------
        Debug.Print "  --- Scripting.FileSystemObject on the >260 leaf ---"

        On Error Resume Next
        r = CStr(fso.FileExists(leaf))
        ReportProbe "FSO FileExists", Err.Number, Err.Description, r
        On Error GoTo Fatal

        On Error Resume Next
        r = CStr(fso.GetFile(leaf).Size)
        ReportProbe "FSO GetFile.Size", Err.Number, Err.Description, r
        On Error GoTo Fatal

        On Error Resume Next
        r = ReadFirstLine(fso, leaf)
        ReportProbe "FSO OpenTextFile", Err.Number, Err.Description, Trim$(r)
        On Error GoTo Fatal

        On Error Resume Next
        r = CreateViaFso(fso, deep)
        ReportProbe "FSO CreateText", Err.Number, Err.Description, r
        On Error GoTo Fatal

        Debug.Print ""
        Debug.Print "  Interpretation:"
        Debug.Print "    FSO all FAIL (53/76/5) -> FSO is 260-capped; matching it is a real feature."
        Debug.Print "    FSO all SUCCEED        -> FSO is long-path aware on this box; check the"
        Debug.Print "                              manifest/registry, then we should match."
        Debug.Print "    Compare the tB rows above to see where WE currently stand."
        
        'Debug.Print leaf
        On Error GoTo 0
        Dim fn As Long, fileSize As Long, buffer As String
        fn = FreeFile()
        'Open "\\?\" & leaf For Binary Access Read As #fn
        Open leaf For Binary Access Read As #fn
        fileSize = LOF(fn)
        If fileSize > 0 Then
            buffer = String$(fileSize, vbNullChar)
            Get #fn,, buffer
        End If
        Close #fn
        Debug.Assert buffer = "hello from a long path" & vbCrLf
        
        ' Does the bare W-API stat the long path, same as Open just did?
        Dim fad As WIN32_FILE_ATTRIBUTE_DATA
        Dim ok As Long
        ok = GetFileAttributesExW(StrPtr(leaf), 0, fad)      ' GetFileExInfoStandard = 0
        Debug.Print "GetFileAttributesExW on 422-char leaf: " & ok & _
                    "  (0 = failed, LastErr " & Err.LastDllError & ")"
        


        ok = GetFileAttributesExW(StrPtr("\\?\" & leaf), 0, fad)   ' same call, prefixed
        Debug.Print "GetFileAttributesExW with \\?\ : " & ok & "  (LastErr " & Err.LastDllError & ")"
        
        Dim a As Long, sz As LongLong, c As Date, m As Date, ac As Date, lf As String
        FSTShared.StatPath leaf, a, sz, c, m, ac, lf
        Debug.Print "leaf = [" & lf & "]"    ' MUST be "the_target_file.txt", not the full path

    CleanUp:
        On Error Resume Next
        sh.Run "cmd /c rd /s /q ""\\?\" & base & """", 0, True   ' rd, not tB DeleteFolder - past 260
        On Error GoTo 0
        Debug.Print vbCrLf & "  (cleaned up)"
        Exit Sub

    Fatal:
        Debug.Print "  HARNESS ERROR " & Err.Number & ": " & Err.Description
        Resume CleanUp
    End Sub

    '======================================================================
    ' Helpers
    '======================================================================

    ' Prints SUCCESS + result, or the captured error. tB has no lambdas, so the
    ' caller does the On Error dance and passes the outcome in.
    Private Sub ReportProbe(ByVal name As String, ByVal errNum As Long, _
                            ByVal errDesc As String, ByVal result As String)
        Dim label As String
        label = Left$(name & String$(18, " "), 18)
        If errNum = 0 Then
            Debug.Print "    " & label & " SUCCESS  -> " & result
        Else
            Debug.Print "    " & label & " FAILED   -> " & errNum & " (" & errDesc & ")"
        End If
    End Sub

    ' Existence checks that work past 260: GetFileAttributesW with the \\?\ prefix.
    ' Cannot use tB FolderExists/FileExists here - they are the thing whose limit we
    ' are working around. Path must be absolute and canonical (it is - built from
    ' GetSpecialFolder + BuildPath).
    Private Function LongFolderExists(ByVal path As String) As Boolean
        Dim a As Long
        a = GetFileAttributesW(StrPtr("\\?\" & path))
        LongFolderExists = (a <> INVALID_FILE_ATTRIBUTES) And ((a And FILE_ATTRIBUTE_DIRECTORY) <> 0)
    End Function

    Private Function LongFileExists(ByVal path As String) As Boolean
        Dim a As Long
        a = GetFileAttributesW(StrPtr("\\?\" & path))
        LongFileExists = (a <> INVALID_FILE_ATTRIBUTES) And ((a And FILE_ATTRIBUTE_DIRECTORY) = 0)
    End Function

    Private Function ReadFirstLine(ByVal fso As Object, ByVal leaf As String) As String
        Dim ts As Object
        Set ts = fso.OpenTextFile(leaf, 1)     ' 1 = ForReading
        ReadFirstLine = ts.ReadLine()
        ts.Close
    End Function

    Private Function CreateViaFso(ByVal fso As Object, ByVal deep As String) As String
        Dim p As String
        p = FileSystemTools.BuildPath(deep, "made_by_fso.txt")
        Dim ts As Object
        Set ts = fso.CreateTextFile(p, True)
        ts.WriteLine "written by fso at " & Len(p) & " chars"
        ts.Close
        CreateViaFso = "wrote " & Len(p) & "-char path"
    End Function

End Module