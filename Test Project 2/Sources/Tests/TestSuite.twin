' ==========================================================================
' tbFileSysTools -- Test Suites
'
' Every test module for the project, in one file.
'
' >>> Start with the TestSuite module directly below. It is the single entry
' >>> point: TestSuite.RunAll() for everything automated and quick.
'
' Nothing here needs to be run in a particular order. The one genuine ordering
' dependency between suites (AppendProbe's Phase D appends to the file
' LargeFileProbe's Phase A creates) is enforced inside TestSuite.RunLargeFile.
'
' All fixtures are created under %TEMP% and cleaned up by the suite that made
' them; TestSuite.CleanUpAll sweeps anything an aborted run left behind.
' No test writes outside %TEMP%, and none depends on a path specific to one
' machine.
'
' MIT License - Copyright (c) 2026, GCUser99 (https://github.com/GCUser99)
' ==========================================================================


' ==========================================================================
' TestSuite  --  START HERE
'
' Single entry point for every test module in this project. Nothing else needs
' to be run by hand, and nothing needs to be run in a particular order: the
' one real ordering dependency (Phase D appends to the file Phase A creates) is
' enforced inside RunLargeFile below, not left to the person running it.
'
' --- Pick a runner --------------------------------------------------------
'
'   TestSuite.RunFast()          Seconds. No fixtures over a few KB, no human,
'                                no meaningful disk use. This is the one to run
'                                after any edit, and the one for CI.
'
'   TestSuite.RunLongPath()      Seconds. Builds a >400-character folder tree in
'                                %TEMP% and exercises every path that had to be
'                                \\?\-prefixed. Cleans up after itself.
'
'   TestSuite.RunLargeFile()     MINUTES, and needs roughly 15 GB free in %TEMP%.
'                                Writes multi-gigabyte files to prove the 64-bit
'                                read/write/append paths. Prompts before starting
'                                and offers to clean up at the end.
'
'   TestSuite.RunInteractive()   Requires a human. Opens real file dialogs and
'                                asks you to click things. Read each prompt.
'
'   TestSuite.RunAll()           RunFast + RunLongPath. The sensible default:
'                                everything that is automated and quick.
'
'   TestSuite.CleanUpAll()       Deletes every fixture any suite could have left
'                                behind, including the multi-GB probe files.
'                                Safe to run at any time.
'
' --- What lives where -----------------------------------------------------
'
'   FAST
'     GeneralTests   The main suite: TextStream, encodings, paths,
'                             file/folder/drive objects, error numbers
'     FsoParityTests          Differential tests against the real
'                             Scripting.FileSystemObject, plus late binding
'     TestRenameCase          Rename, case-only renames, bad-name error parity
'     MergeTextFilesTests         MergeTextFiles, incl. the path-aliasing data-loss case
'     AdvancePositionTests    TextStream Line/Column bookkeeping, 14 CR/LF cases
'     FileDialogTests         The automated (non-clicking) half of the dialog suite
'
'   LONG PATH
'     LongPathWriteTests      11 round trips on a >400-char tree
'     LongPathOracle          Discovery probe: what the REAL FSO does past 260.
'                             Prints rather than asserts - read the output
'
'   LARGE FILE  (slow, GB-scale)
'     LargeFileProbe          Phases A/B/C: raw Put, TextStream write, read-back
'     AppendProbe             Phase D: FILE_APPEND_DATA append to a >2 GB file
'                             REQUIRES Phase A to have run - RunLargeFile does this
'     MultiByteProbe          54 M lines of UTF-16LE and UTF-8 across chunk edges
'     SeekProbe               Pins the 32-bit Seek/LOF limits the design works around
'
'   INTERACTIVE
'     FileDialogTests         Dialogs that need clicking, including the veto test
'
' --- Reading the output ---------------------------------------------------
' Two reporting styles are in use, deliberately:
'   * Suites built on tB's Assert.* raise on the first failure and report through
'     the IDE's test panel.
'   * Probe-style suites print "PASS"/"FAIL" lines and a tally, because they are
'     measuring behaviour (often against the real FSO) rather than asserting a
'     known answer. A FAIL line there is a finding to read, not just a red light.
' ==========================================================================

Private Module TestSuite
    Option Explicit

    ' Rough free space the large-file probes need in %TEMP%, in bytes.
    Private Const LARGEFILE_BYTES_NEEDED As LongLong = 15000000000^

    '======================================================================
    ' Runners
    '======================================================================

    ' Everything automated and quick. The default.
    Public Sub RunAll()
        Dim t As Single: t = Timer
        Banner "RUNNING: fast + long-path suites"
        RunFast
        RunLongPath
        Banner "DONE in " & Format$(Timer - t, "0.0") & "s"
        Debug.Print "  (RunLargeFile and RunInteractive are not included - see the header.)"
    End Sub

    ' Seconds. Safe to run anywhere, any time.
    Public Sub RunFast()
        Banner "FAST SUITES"

        Section "GeneralTests"
        GeneralTests.RunAllTests

        Section "FsoParityTests"
        FsoParityTests.RunParityTests

        Section "NameValidationTests"
        NameValidationTests.RunAll

        Section "MergeTextFilesTests"
        MergeTextFilesTests.RunAll

        Section "AdvancePositionTests"
        AdvancePositionTests.RunAll
    End Sub

    ' Builds and tears down a >400-character tree in %TEMP%.
    Public Sub RunLongPath()
        Banner "LONG-PATH SUITES"

        Section "LongPathWriteTests"
        LongPathWriteTests.RunAll

        Section "LongPathOracle (discovery - read the output)"
        LongPathOracle.Run
    End Sub

    ' Minutes, and gigabytes. Prompts first.
    '
    ' ORDER IS ENFORCED HERE, not left to the caller: AppendProbe's Phase D1
    ' appends to the 2.4 GB file LargeFileProbe's Phase A leaves behind. Running
    ' AppendProbe first gives a confusing "file not found"; running LargeFileProbe
    ' AGAIN after Phase D would fail Phase C, whose block arithmetic assumes the
    ' file has not been appended to. So: A/B/C, then D, then clean up.
    Public Sub RunLargeFile()
        If MsgBox("The large-file probes write multi-gigabyte files to %TEMP% and " & _
                  "take several minutes." & vbCrLf & vbCrLf & _
                  "Free space needed: about 15 GB." & vbCrLf & _
                  "Location: " & FileSystemTools.GetSpecialFolder(sfTemporaryFolder) & vbCrLf & vbCrLf & _
                  "Continue?", vbYesNo Or vbQuestion, "Large-file probes") <> vbYes Then
            Debug.Print "Large-file probes skipped."
            Exit Sub
        End If

        If Not HasFreeSpace(LARGEFILE_BYTES_NEEDED) Then
            Debug.Print "*** Not enough free space on the %TEMP% volume - aborting."
            Debug.Print "    Free up space or point %TEMP% at a larger volume."
            Exit Sub
        End If

        Dim t As Single: t = Timer
        Banner "LARGE-FILE PROBES (this will take a while)"

        Section "SeekProbe (fast - pins the limits the design works around)"
        SeekProbe.RunAll

        Section "LargeFileProbe phases A/B/C"
        LargeFileProbe.RunAll

        Section "AppendProbe phase D  (appends to Phase A's file - order matters)"
        AppendProbe.RunAll

        Section "MultiByteProbe (54 M lines)"
        MultiByteProbe.RunAll

        Banner "LARGE-FILE PROBES DONE in " & Format$((Timer - t) / 60, "0.0") & " min"

        If MsgBox("Delete the multi-gigabyte probe files from %TEMP% now?", _
                  vbYesNo Or vbQuestion, "Clean up") = vbYes Then
            CleanUpAll
        Else
            Debug.Print "  Probe files left in place. Run TestSuite.CleanUpAll when done."
        End If
    End Sub

    ' Removes every fixture any suite could have left behind. Best-effort and
    ' idempotent: missing files are not an error, so this is always safe to run.
    Public Sub CleanUpAll()
        Banner "CLEAN UP"
        On Error Resume Next
        LargeFileProbe.CleanUp
        MultiByteProbe.CleanUp
        AppendProbe.CleanUp
        On Error GoTo 0

        ' Anything the suites name predictably, swept in one pass.
        Dim tmp As String
        tmp = FileSystemTools.GetSpecialFolder(sfTemporaryFolder)
        SweepDelete FileSystemTools.BuildPath(tmp, "_probe_*.bin")
        SweepDelete FileSystemTools.BuildPath(tmp, "_probe_*.txt")

        SweepDeleteFolder FileSystemTools.BuildPath(tmp, "lpwrite")
        SweepDeleteFolder FileSystemTools.BuildPath(tmp, "longpath")
        SweepDeleteFolder FileSystemTools.BuildPath(tmp, "mergetests")

        Debug.Print "  Clean up complete."
    End Sub

    '======================================================================
    ' Helpers
    '======================================================================

    Private Sub Banner(ByVal text As String)
        Debug.Print vbCrLf & String$(70, "=")
        Debug.Print "  " & text
        Debug.Print String$(70, "=")
    End Sub

    Private Sub Section(ByVal text As String)
        Debug.Print vbCrLf & "---- " & text & " " & String$(Max2(0, 60 - Len(text)), "-")
    End Sub

    Private Function Max2(ByVal a As Long, ByVal b As Long) As Long
        If a > b Then Max2 = a Else Max2 = b
    End Function

    ' Wildcard delete that never raises - ignoreMissing:=True covers "nothing matched".
    Private Sub SweepDelete(ByVal pattern As String)
        On Error Resume Next
        FileSystemTools.DeleteFile pattern, True, True
        On Error GoTo 0
    End Sub

    ' Long-path safe folder removal: the long-path fixtures are past 260 chars,
    ' so this goes through cmd's rd with a \\?\ prefix rather than DeleteFolder.
    Private Sub SweepDeleteFolder(ByVal folderPath As String)
        On Error Resume Next
        FileSystemTools.DeleteFolder folderPath, True, True
        If Err.Number <> 0 Then
            Err.Clear
            Dim sh As Object
            Set sh = CreateObject("WScript.Shell")
            sh.Run "cmd /c rd /s /q ""\\?\" & folderPath & """", 0, True
        End If
        On Error GoTo 0
    End Sub

    ' True if the %TEMP% volume has at least bytesNeeded free.
    Private Function HasFreeSpace(ByVal bytesNeeded As LongLong) As Boolean
        On Error Resume Next
        Dim d As Drive
        Set d = FileSystemTools.GetDrive( _
                    FileSystemTools.GetDriveName( _
                        FileSystemTools.GetSpecialFolder(sfTemporaryFolder)))
        If Err.Number <> 0 Then HasFreeSpace = True: Exit Function   ' can't tell -> don't block
        Dim free As LongLong
        free = d.AvailableSpace
        If Err.Number <> 0 Then HasFreeSpace = True: Exit Function
        On Error GoTo 0
        Debug.Print "  Free space on " & d.DriveLetter & ": " & _
                    Format$(free / 1000000000#, "0.0") & " GB (need ~" & _
                    Format$(bytesNeeded / 1000000000#, "0") & " GB)"
        HasFreeSpace = (free >= bytesNeeded)
    End Function

End Module