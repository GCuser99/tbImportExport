Public Module DLLExports
    ' these are for use if calling the DLL without registration
    ' use following format to declare and use in VBA:
    '
    ' Public Declare PtrSafe Function New_FileSystem Lib "[path to dll folder]\tbFileSysTools_win64.dll" () As Object
    ' Dim fso As Object  
    ' Set fso = New_FileSystemObject()
    Public Function New_FileSystemObject() As Object
        Set New_FileSystemObject = New FileSystemObject
    End Function
    
End Module