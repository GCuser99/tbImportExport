' https://github.com/GCuser99/tbImportExport/tree/main
' License: MIT
'
' modImpExp -- twinpack/twinproj parser, serializer, importer, exporter.
'
' Wire format (all integers little-endian):
'
'   u32  magic = 0xEA0BA51C
'   entry:
'     i16  kind        (at the ROOT this field is the format version)
'     u32  nameLen + UTF-8 name bytes
'     u64  revision
'     u32  flags
'     u8   category
'     if file (kind = 1 and not root):
'       u32  contentLen + content bytes
'       u32  revisionCount + revisionCount * u32
'     else:
'       u32  childCount + childCount * entry

Private Module modImpExp

    Option Explicit

    ' ------------------------------------------------------------- constants

    ' 0xEA0BA51C does not fit in a signed Long. twinBASIC has no unsigned
    ' integer types yet (they are planned but slated for after v1), so the
    ' magic is held as its two's-complement signed value. Equality is the
    ' only operation performed on it, so the sign is irrelevant.
    ' If the compiler ever rejects the hex literal, substitute -368335588.
    Public Const IE_MAGIC As Long = &HEA0BA51C          ' = -368335588
    Public Const IE_FORMAT_VERSION As Integer = 1

    Public Const IE_FLAGS_NONE As Long = &H0
    Public Const IE_FLAGS_HIDDEN As Long = &H1
    Public Const IE_FLAGS_SUPER_HIDDEN As Long = &H2
    Public Const IE_FLAGS_VIRTUAL As Long = &H4

    Public Const IE_CATEGORY_DEFAULT As Byte = &H0
    Public Const IE_CATEGORY_REFERENCES As Byte = &H1   ' always virtual; never serialized
    Public Const IE_CATEGORY_RESOURCES As Byte = &H2
    Public Const IE_CATEGORY_SOURCES As Byte = &H3
    Public Const IE_CATEGORY_SETTINGS As Byte = &H4
    Public Const IE_CATEGORY_IMPORTED_TYPELIBS As Byte = &H5
    Public Const IE_CATEGORY_MISCELLANEOUS As Byte = &H6
    Public Const IE_CATEGORY_PACKAGES As Byte = &H7

    Public Const IE_ERR_BAD_MAGIC As Long = vbObjectError + 1001
    Public Const IE_ERR_BAD_VERSION As Long = vbObjectError + 1002
    Public Const IE_ERR_TRUNCATED As Long = vbObjectError + 1003
    Public Const IE_ERR_BAD_UTF8 As Long = vbObjectError + 1004
    Public Const IE_ERR_IO As Long = vbObjectError + 1005

    Public Enum EntryKindEnum
        ekFile = 1
        ekDirectory = 2
    End Enum

    ' Result of an import or export, so callers can report without the
    ' worker having to know how to print.
    Public Type IE_RESULT
        Name      As String
        Size      As Long
        FileCount As Long
        DirCount  As Long
    End Type

    ' ================================================== category mapping ===

    ' Well-known entry names that get a non-default category on export.
    ' "References" is deliberately absent: the IDE materialises it
    ' virtually and never serializes it, so tagging an on-disk folder with
    ' category 0x01 would confuse the IDE on import.
    Public Function CategoryFor(ByVal name As String) As Byte
        Select Case name
            Case "Resources":              Return IE_CATEGORY_RESOURCES
            Case "Sources":                Return IE_CATEGORY_SOURCES
            Case "Settings":               Return IE_CATEGORY_SETTINGS
            Case "ImportedTypeLibraries":  Return IE_CATEGORY_IMPORTED_TYPELIBS
            Case "Miscellaneous":          Return IE_CATEGORY_MISCELLANEOUS
            Case "Packages":               Return IE_CATEGORY_PACKAGES
            Case Else:                     Return IE_CATEGORY_DEFAULT
        End Select
    End Function
    
    ' The well-known category folder names, as a delimited list. This MUST
    ' stay in sync with the Case labels in CategoryFor above -- they are the
    ' same set. "References" is excluded here for the same reason it is
    ' excluded there: it is never serialized.
    '
    ' Used only by the informational missing-folder note in DoExport. It does
    ' NOT drive packing: absent folders stay absent in the output, because a
    ' packer faithfully mirrors the disk and the IDE reconstructs whatever
    ' expected folders are missing when it opens the result. The note exists
    ' so the operator can SEE which expected folders weren't on disk, not so
    ' the tool can invent them.
    Private Function WellKnownCategoryNames() As String
        Return "Resources|Sources|Settings|ImportedTypeLibraries|Miscellaneous|Packages"
    End Function

    ' ============================================ parser (binary -> tree) ===

    Public Function ParseBuffer(ByRef data() As Byte, ByVal length As Long) As Entry
        Dim rd As ByteReader
        Set rd = New ByteReader
        rd.Init data, length

        On Error GoTo Propagate

        Dim magic As Long
        magic = rd.ReadLong()
        If magic <> IE_MAGIC Then
            Err.Raise IE_ERR_BAD_MAGIC, "ParseBuffer", _
                      "Bad magic: 0x" & Right$("00000000" & Hex$(magic), 8) & _
                      ", expected 0x" & Right$("00000000" & Hex$(IE_MAGIC), 8)
        End If

        Dim entryCount As Long
        entryCount = 0
        Return ReadEntry(rd, entryCount)

Propagate:
        ' An error raised inside ByteReader arrives here stripped of its
        ' description by the COM boundary. Recover it and re-raise from
        ' module scope, where it propagates intact.
        Dim num As Long, src As String, desc As String
        num = Err.Number
        src = Err.Source
        desc = Err.Description
        If Len(rd.ErrorText) > 0 Then
            num = IE_ERR_TRUNCATED
            src = "ParseBuffer"
            desc = rd.ErrorText
        End If
        Err.Raise num, src, desc
    End Function

    Private Function ReadEntry(ByVal rd As ByteReader, ByRef entryCount As Long) As Entry
        ' At the root this 2-byte field is the file format version;
        ' everywhere else it is the entry kind (1 = file, 2 = directory).
        Dim kind As Integer
        kind = rd.ReadInt16()

        entryCount = entryCount + 1
        Dim isRoot As Boolean
        isRoot = (entryCount = 1)

        If isRoot And kind <> IE_FORMAT_VERSION Then
            Err.Raise IE_ERR_BAD_VERSION, "ReadEntry", _
                      "Unsupported file format version: " & CStr(kind) & _
                      ", expected " & CStr(IE_FORMAT_VERSION)
        End If

        Dim e As Entry
        Set e = New Entry
        e.Name = rd.ReadString()
        e.Revision = rd.ReadLongLong()
        e.Flags = rd.ReadLong()
        e.Category = rd.ReadByte()

        Dim i As Long
        Dim n As Long

        If kind = 1 And Not isRoot Then
            e.Kind = ekFile
            Dim blob() As Byte
            Dim blobLen As Long
            rd.ReadBlob blob, blobLen
            e.SetContent blob, blobLen

            n = rd.ReadLong()
            e.AllocRevisions n
            For i = 0 To n - 1
                e.RevisionItem(i) = rd.ReadLong()
            Next
            Return e
        End If

        e.Kind = ekDirectory
        n = rd.ReadLong()
        For i = 1 To n
            e.Children.Add ReadEntry(rd, entryCount)
        Next
        Return e
    End Function

    ' ======================================= serializer (tree -> binary) ===

    Public Function SerializeTree(ByVal root As Entry, ByRef outLen As Long) As Byte()
        Dim bb As ByteBuffer
        Set bb = New ByteBuffer
        bb.PutLong IE_MAGIC

        Dim isFirst As Boolean
        isFirst = True
        WriteEntry bb, root, isFirst

        outLen = bb.Length
        Return bb.ToArray()
    End Function

    Private Sub WriteStr(ByVal bb As ByteBuffer, ByVal s As String)
        Dim b() As Byte
        Dim n As Long
        Utf8Encode s, b, n
        bb.PutLong n
        bb.PutBytes b, n
    End Sub

    Private Sub WriteEntry(ByVal bb As ByteBuffer, ByVal e As Entry, ByRef isFirst As Boolean)
        Dim isRoot As Boolean
        isRoot = isFirst
        isFirst = False

        Dim i As Long

        If e.Kind = ekFile And Not isRoot Then
            bb.PutInt16 1
            WriteStr bb, e.Name
            bb.PutLongLong e.Revision
            bb.PutLong e.Flags
            bb.PutByte e.Category

            Dim c() As Byte
            c = e.GetContent()
            bb.PutLong e.ContentLen
            bb.PutBytes c, e.ContentLen

            bb.PutLong e.RevisionCount
            For i = 0 To e.RevisionCount - 1
                bb.PutLong e.RevisionItem(i)
            Next
        Else
            ' Root entry writes the format version; a non-root directory
            ' writes kind = 2.
            If isRoot Then
                bb.PutInt16 IE_FORMAT_VERSION
            Else
                bb.PutInt16 2
            End If
            WriteStr bb, e.Name
            bb.PutLongLong e.Revision
            bb.PutLong e.Flags
            bb.PutByte e.Category

            bb.PutLong e.Children.Count
            For i = 1 To e.Children.Count
                WriteEntry bb, e.Children.Item(i), isFirst
            Next
        End If
    End Sub

    ' ============================================ import (binary -> disk) ===

    Public Function DoImport(ByVal inputPath As String, _
                             ByVal outputDir As String, _
                             ByVal quiet As Boolean) As IE_RESULT
        Dim data() As Byte
        Dim length As Long
        ReadWholeFile inputPath, data, length

        Dim root As Entry
        Set root = ParseBuffer(data, length)

        If Len(outputDir) = 0 Then outputDir = root.Name

        Dim res As IE_RESULT
        res.Name = root.Name

        EnsureDirectory outputDir

        Dim i As Long
        For i = 1 To root.Children.Count
            ExtractEntry root.Children.Item(i), outputDir, res
        Next

        If Not quiet Then
            Say "Imported """ & root.Name & """ -> " & outputDir & "\  (" & _
                CStr(res.FileCount) & " files, " & CStr(res.DirCount) & " directories)"
        End If
        Return res
    End Function

    Private Sub ExtractEntry(ByVal e As Entry, ByVal parentDir As String, ByRef res As IE_RESULT)
        If e.Kind = ekFile Then
            Dim c() As Byte
            c = e.GetContent()
            WriteWholeFile JoinPath(parentDir, e.Name), c, e.ContentLen
            res.FileCount = res.FileCount + 1
        Else
            Dim d As String
            d = JoinPath(parentDir, e.Name)
            EnsureDirectory d
            res.DirCount = res.DirCount + 1
            Dim i As Long
            For i = 1 To e.Children.Count
                ExtractEntry e.Children.Item(i), d, res
            Next
        End If
    End Sub

    ' ============================================ export (disk -> binary) ===

    Public Function DoExport(ByVal inputDir As String, _
                             ByVal outputPath As String, _
                             ByVal quiet As Boolean) As IE_RESULT
        If Not IsDirectory(inputDir) Then
            Err.Raise IE_ERR_IO, "DoExport", "Not a directory: " & inputDir
        End If

        Dim root As Entry
        Set root = BuildTree(inputDir)

        Dim buf() As Byte
        Dim length As Long
        buf = SerializeTree(root, length)
        WriteWholeFile outputPath, buf, length

        Dim res As IE_RESULT
        res.Name = root.Name
        res.Size = length

        Dim i As Long
        For i = 1 To root.Children.Count
            CountEntry root.Children.Item(i), res
        Next

        Dim missing As String
        missing = FindMissingCategoryFolders(root)

        If Not quiet Then
            Say "Exported """ & root.Name & """ -> " & outputPath & "  (" & _
                CStr(length) & " bytes, " & CStr(res.FileCount) & " files, " & _
                CStr(res.DirCount) & " directories)"
            If Len(missing) > 0 Then
                ' Informational only -- not a warning, not an error. These
                ' folders were not on disk at pack time (commonly because they
                ' were empty and dropped by a version-control round trip). The
                ' IDE recreates the ones it needs on open; nothing is wrong
                ' with the packed file.
                Say "  note: expected folders not present on disk: " & missing & "."
                Say "  twinBASIC should rebuild then on Open."""
            End If
        End If
        Return res
    End Function

    ' Returns a comma-separated list of well-known category folder names that
    ' are absent from the top level of the tree, or "" if all are present.
    ' Top level only: these folders live directly under the project root, and
    ' a like-named folder nested elsewhere is not the category folder.
    Private Function FindMissingCategoryFolders(ByVal root As Entry) As String
        Dim known() As String
        known = Split(WellKnownCategoryNames(), "|")

        Dim result As String
        result = ""

        Dim k As Long
        For k = LBound(known) To UBound(known)
            If Not HasTopLevelChildDir(root, known(k)) Then
                If Len(result) > 0 Then result = result & ", "
                result = result & known(k)
            End If
        Next
        Return result
    End Function

    Private Function HasTopLevelChildDir(ByVal root As Entry, ByVal name As String) As Boolean
        Dim i As Long
        For i = 1 To root.Children.Count
            Dim c As Entry
            Set c = root.Children.Item(i)
            If c.Kind = ekDirectory Then
                ' Ordinal, case-sensitive match -- the same comparison the
                ' rest of the tool uses, so "sources" is not treated as
                ' "Sources".
                If OrdinalCompare(c.Name, name) = 0 Then Return True
            End If
        Next
        Return False
    End Function

    Private Sub CountEntry(ByVal e As Entry, ByRef res As IE_RESULT)
        If e.Kind = ekFile Then
            res.FileCount = res.FileCount + 1
        Else
            res.DirCount = res.DirCount + 1
            Dim i As Long
            For i = 1 To e.Children.Count
                CountEntry e.Children.Item(i), res
            Next
        End If
    End Sub

    Private Function BuildTree(ByVal dirPath As String) As Entry
        Dim e As Entry
        Set e = New Entry
        e.Kind = ekDirectory
        e.Name = BaseName(AbsPath(dirPath))
        e.Revision = 0
        e.Flags = IE_FLAGS_NONE
        e.Category = CategoryFor(e.Name)

        Dim names() As String
        Dim isDir() As Boolean
        Dim count As Long
        ListDirectory dirPath, names, isDir, count

        ' Split into directories and files, then sort each with an ordinal
        ' comparison. The reference tool sorts the combined listing once and
        ' then partitions it, which yields the same relative order.
        Dim dirs() As String, files() As String
        Dim nd As Long, nf As Long
        ReDim dirs(0 To IIf(count = 0, 0, count - 1))
        ReDim files(0 To IIf(count = 0, 0, count - 1))
        nd = 0
        nf = 0

        Dim i As Long
        For i = 0 To count - 1
            If isDir(i) Then
                dirs(nd) = names(i)
                nd = nd + 1
            Else
                files(nf) = names(i)
                nf = nf + 1
            End If
        Next

        SortStrings dirs, nd
        SortStrings files, nf

        ' Directories first, then files -- matching the reference layout.
        For i = 0 To nd - 1
            e.Children.Add BuildTree(JoinPath(dirPath, dirs(i)))
        Next

        Dim fe As Entry
        Dim b() As Byte
        Dim n As Long
        For i = 0 To nf - 1
            Set fe = New Entry
            fe.Kind = ekFile
            fe.Name = files(i)
            fe.Revision = 2
            fe.Flags = IE_FLAGS_NONE
            fe.Category = CategoryFor(files(i))
            ReadWholeFile JoinPath(dirPath, files(i)), b, n
            fe.SetContent b, n
            fe.AllocRevisions 0
            e.Children.Add fe
        Next

        Return e
    End Function

End Module
