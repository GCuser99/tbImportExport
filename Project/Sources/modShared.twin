' https://github.com/GCuser99/tbImportExport/tree/main
' License: MIT
'
' modShared -- platform layer: UTF-8 conversion, directory enumeration,
' path handling, ordinal string sorting.

Module modShared

    Option Explicit
    
    Private Const IE_LONGPATH_THRESHOLD As Long = 248

    ' ============================================================== UTF-8 ===

    ' twinBASIC strings are UTF-16 BSTRs, and StrConv(vbFromUnicode) uses the
    ' ANSI codepage rather than UTF-8, so the conversion has to go through
    ' the codepage APIs.

    Public Function Utf8Decode(ByRef b() As Byte, ByVal offset As Long, ByVal length As Long) As String
        If length <= 0 Then Return ""
        Dim cch As Long
        cch = MultiByteToWideChar(CP_UTF8, 0, VarPtr(b(offset)), length, 0, 0)
        If cch <= 0 Then
            Err.Raise IE_ERR_BAD_UTF8, "Utf8Decode", "Invalid UTF-8 sequence in file"
        End If
        Dim s As String
        s = String$(cch, vbNullChar)
        MultiByteToWideChar CP_UTF8, 0, VarPtr(b(offset)), length, StrPtr(s), cch
        Return s
    End Function

    Public Sub Utf8Encode(ByVal s As String, ByRef outBuf() As Byte, ByRef outLen As Long)
        outLen = 0
        Erase outBuf
        If Len(s) = 0 Then Exit Sub
        Dim cb As Long
        cb = WideCharToMultiByte(CP_UTF8, 0, StrPtr(s), Len(s), 0, 0, 0, ByVal 0)
        If cb <= 0 Then
            Err.Raise IE_ERR_BAD_UTF8, "Utf8Encode", "Cannot encode string as UTF-8"
        End If
        ReDim outBuf(0 To cb - 1)
        WideCharToMultiByte CP_UTF8, 0, StrPtr(s), Len(s), VarPtr(outBuf(0)), cb, 0, ByVal 0
        outLen = cb
    End Sub

    ' ============================================================== paths ===

    Public Function JoinPath(ByVal a As String, ByVal b As String) As String
        If Len(a) = 0 Then Return b
        If Right$(a, 1) = "\" Or Right$(a, 1) = "/" Then Return a & b
        Return a & "\" & b
    End Function

    Public Function AbsPath(ByVal p As String) As String
        Dim buf As String
        Dim n As Long
        buf = String$(32768, vbNullChar)
        n = GetFullPathNameW(StrPtr(p), 32768, StrPtr(buf), ByVal 0)
        If n = 0 Or n > 32768 Then Return p
        Return Left$(buf, n)
    End Function

    ' Trailing separators are stripped first so that "C:\foo\" yields "foo".
    Public Function BaseName(ByVal p As String) As String
        Do While Len(p) > 1 And (Right$(p, 1) = "\" Or Right$(p, 1) = "/")
            p = Left$(p, Len(p) - 1)
        Loop
        Dim i As Long
        For i = Len(p) To 1 Step -1
            If Mid$(p, i, 1) = "\" Or Mid$(p, i, 1) = "/" Then
                Return Mid$(p, i + 1)
            End If
        Next
        Return p
    End Function

    Public Function ParentPath(ByVal p As String) As String
        Do While Len(p) > 1 And (Right$(p, 1) = "\" Or Right$(p, 1) = "/")
            p = Left$(p, Len(p) - 1)
        Loop
        Dim i As Long
        For i = Len(p) To 1 Step -1
            If Mid$(p, i, 1) = "\" Or Mid$(p, i, 1) = "/" Then
                Return Left$(p, i - 1)
            End If
        Next
        Return ""
    End Function

    ' ========================================================= filesystem ===

    Public Function PathExists(ByVal p As String) As Boolean
        Return GetFileAttributesW(StrPtr(ApiPath(p))) <> INVALID_FILE_ATTRIBUTES
    End Function

    Public Function IsDirectory(ByVal p As String) As Boolean
        Dim a As Long
        a = GetFileAttributesW(StrPtr(ApiPath(p)))
        If a = INVALID_FILE_ATTRIBUTES Then Return False
        Return (a And FILE_ATTRIBUTE_DIRECTORY) <> 0
    End Function
    
    ' os.makedirs(path, exist_ok=True)
    Public Sub EnsureDirectory(ByVal p As String)
        If Len(p) = 0 Then Exit Sub
        Dim full As String
        full = AbsPath(p)
        If IsDirectory(full) Then Exit Sub
        Dim parent As String
        parent = ParentPath(full)
        If Len(parent) > 0 And Not IsDirectory(parent) Then EnsureDirectory parent
        If CreateDirectoryW(StrPtr(ApiPath(full)), ByVal vbNullPtr) = 0 Then
            If Not IsDirectory(full) Then
                Err.Raise IE_ERR_IO, "EnsureDirectory", "Cannot create directory: " & full
            End If
        End If
    End Sub

    Private Function WCharBufToStr(ByRef firstChar As Integer, ByVal maxChars As Long) As String
        Dim tmp() As Integer
        ReDim tmp(0 To maxChars - 1)
        CopyMemory tmp(0), firstChar, maxChars * 2
        Dim n As Long
        For n = 0 To maxChars - 1
            If tmp(n) = 0 Then Exit For
        Next
        If n = 0 Then Return ""
        Dim s As String
        s = String$(n, vbNullChar)
        CopyMemory ByVal StrPtr(s), tmp(0), n * 2
        Return s
    End Function

    ' os.listdir(). The whole enumeration completes before returning, so
    ' callers are free to recurse afterwards -- unlike Dir$, which cannot
    ' have two enumerations in flight at once.
    Public Sub ListDirectory(ByVal dirPath As String, _
                             ByRef outNames() As String, _
                             ByRef outIsDir() As Boolean, _
                             ByRef outCount As Long)
        
        'Dim fd As IE_FIND_DATA
        Dim fd As WIN32_FIND_DATAW
        Dim h As LongPtr
        Dim pattern As String
        Dim cap As Long
        Dim nm As String

        cap = 64
        ReDim outNames(0 To cap - 1)
        ReDim outIsDir(0 To cap - 1)
        outCount = 0

        pattern = ApiPath(JoinPath(dirPath, "*"))
        h = FindFirstFileW(StrPtr(pattern), fd)
        If h = INVALID_HANDLE_VALUE Then Exit Sub

        Do
            nm = WCharBufToStr(fd.cFileName(0), MAX_PATH)
            If nm <> "." And nm <> ".." And Len(nm) > 0 Then
                If outCount = cap Then
                    cap = cap * 2
                    ReDim Preserve outNames(0 To cap - 1)
                    ReDim Preserve outIsDir(0 To cap - 1)
                End If
                outNames(outCount) = nm
                outIsDir(outCount) = ((fd.dwFileAttributes And FILE_ATTRIBUTE_DIRECTORY) <> 0)
                outCount = outCount + 1
            End If
        Loop While FindNextFileW(h, fd) <> 0

        FindClose h
    End Sub

    Public Sub ReadWholeFile(ByVal path As String, ByRef outBuf() As Byte, ByRef outLen As Long)
        Dim f As Integer
        f = FreeFile
        Open path For Binary Access Read As #f
        outLen = LOF(f)
        If outLen > 0 Then
            ReDim outBuf(0 To outLen - 1)
            Get #f, 1, outBuf
        Else
            Erase outBuf
        End If
        Close #f
    End Sub

    ' The caller's array is written directly when it is already exactly
    ' `length` bytes with a zero lower bound, which is the case for every
    ' caller in this project: ByteBuffer.ToArray and Entry.GetContent both
    ' return trimmed arrays. The copy is retained only as a fallback for an
    ' over-allocated array, since Put would otherwise write the slack bytes
    ' too. Skipping it takes peak memory on export from roughly 4x the file
    ' size down to 3x.
    Public Sub WriteWholeFile(ByVal path As String, ByRef buf() As Byte, ByVal length As Long)
        Dim f As Integer
        If PathExists(path) Then Kill path
        f = FreeFile
        Open path For Binary Access Write As #f
        If length > 0 Then
            If LBound(buf) = 0 And UBound(buf) = length - 1 Then
                Put #f, 1, buf
            Else
                Dim tmp() As Byte
                ReDim tmp(0 To length - 1)
                CopyMemory tmp(0), buf(0), length
                Put #f, 1, tmp
            End If
        End If
        Close #f
    End Sub

    ' Counts path segments below the drive root, so callers can refuse to
    ' recursively delete something dangerously shallow. "C:\" -> 0,
    ' "C:\Downloads" -> 1, "C:\Users\me\proj" -> 3. UNC roots
    ' (\\server\share) count the share as depth 0 as well. Used to guard the
    ' clean-first delete in DoImport against a fat-fingered target like a
    ' drive root.
    Public Function PathDepth(ByVal p As String) As Long
        Dim full As String
        full = AbsPath(p)
        ' Strip a trailing separator so "C:\foo\" and "C:\foo" agree.
        Do While Len(full) > 1 And (Right$(full, 1) = "\" Or Right$(full, 1) = "/")
            full = Left$(full, Len(full) - 1)
        Loop

        Dim body As String
        If Left$(full, 2) = "\\" Then
            ' UNC: skip "\\", then drop server and share, each a segment we do
            ' NOT count -- depth is measured below the share root.
            Dim rest As String
            rest = Mid$(full, 3)
            Dim slash1 As Long, slash2 As Long
            slash1 = InStr(rest, "\")
            If slash1 = 0 Then Return 0                 ' just \\server
            slash2 = InStr(slash1 + 1, rest, "\")
            If slash2 = 0 Then Return 0                 ' \\server\share
            body = Mid$(rest, slash2 + 1)
        Else
            ' Drive-letter path: drop "X:" then the leading separator.
            Dim colon As Long
            colon = InStr(full, ":")
            If colon = 0 Then
                body = full                             ' unusual, treat whole as body
            Else
                body = Mid$(full, colon + 1)
                Do While Len(body) > 0 And (Left$(body, 1) = "\" Or Left$(body, 1) = "/")
                    body = Mid$(body, 2)
                Loop
            End If
        End If

        If Len(body) = 0 Then Return 0
        Dim parts() As String
        parts = Split(Replace$(body, "/", "\"), "\")
        Dim depth As Long, i As Long
        depth = 0
        For i = LBound(parts) To UBound(parts)
            If Len(parts(i)) > 0 Then depth = depth + 1
        Next
        Return depth
    End Function

    ' Recursive delete, used by the self-test cleanup and the clean-first
    ' option in DoImport.
    Public Sub DeleteTree(ByVal dirPath As String)
        If Not IsDirectory(dirPath) Then Exit Sub
        Dim names() As String, isDir() As Boolean, n As Long, i As Long
        ListDirectory dirPath, names, isDir, n
        For i = 0 To n - 1
            If isDir(i) Then
                DeleteTree JoinPath(dirPath, names(i))
            Else
                Kill JoinPath(dirPath, names(i))
            End If
        Next
        RmDir dirPath
    End Sub
    

    ' Prefixes a path for a raw Win32 W-API call ONLY when it exceeds the
    ' legacy limit, so short paths keep normal semantics. \\?\ disables the
    ' "." / ".." collapse and forward-slash acceptance that GetFullPathNameW
    ' performs, so the input MUST already be absolute and canonical -- this
    ' may only ever wrap AbsPath output, never a raw caller string. The CLI
    ' resolves both arguments through AbsPath at the boundary, which is what
    ' makes that guarantee hold.
    '
    ' 248, not 260: directory creation (CreateDirectoryW) needs MAX_PATH
    ' minus 12 for a possible 8.3 name, and one threshold everywhere keeps
    ' the rule simple.
    Public Function ApiPath(ByVal canonicalAbsPath As String) As String
        If Len(canonicalAbsPath) < IE_LONGPATH_THRESHOLD Then
            Return canonicalAbsPath
        End If
        ' UNC (\\server\share) becomes \\?\UNC\server\share; the two leading
        ' backslashes are replaced by the UNC form, not kept.
        If Left$(canonicalAbsPath, 2) = "\\" Then
            Return "\\?\UNC\" & Mid$(canonicalAbsPath, 3)
        End If
        Return "\\?\" & canonicalAbsPath
    End Function

    ' =============================================================== sort ===

    ' Ordinal (code-unit) comparison. This must NOT be a locale-aware or
    ' case-insensitive comparison: Python's sorted() orders by code point,
    ' and any divergence here changes the child ordering in the output file,
    ' so exports would stop being byte-identical to the reference tool for
    ' any project with mixed-case or non-ASCII filenames.
    Public Function OrdinalCompare(ByVal a As String, ByVal b As String) As Long
        Return StrComp(a, b, vbBinaryCompare)
    End Function

    ' Shell sort -- no recursion, stable enough for our purposes (names
    ' within a directory are unique, so stability is moot), and fast enough
    ' for directories with tens of thousands of entries.
    Public Sub SortStrings(ByRef arr() As String, ByVal count As Long)
        If count < 2 Then Exit Sub
        Dim gap As Long, i As Long, j As Long
        Dim tmp As String
        gap = 1
        Do While gap < count \ 3
            gap = gap * 3 + 1
        Loop
        Do While gap >= 1
            For i = gap To count - 1
                tmp = arr(i)
                j = i
                Do While j >= gap
                    If OrdinalCompare(arr(j - gap), tmp) <= 0 Then Exit Do
                    arr(j) = arr(j - gap)
                    j = j - gap
                Loop
                arr(j) = tmp
            Next
            gap = gap \ 3
        Loop
    End Sub

End Module
