' https://github.com/GCuser99/tbImportExport/tree/main
' License: MIT
'
' modSelfTest -- self-test suite.
'
' Differences from the Python original, which are deliberate:
'
'   * The sample file is OPTIONAL. The Python version hardcodes a path to
'     indexer/sample.twinpack in twinBASIC's own development repository and
'     exits(1) when it is absent -- which is every time, since that fixture
'     is not part of the published download. Here the four sample-driven
'     tests are skipped with [SKIP] when no sample is supplied, and the
'     synthetic tests still run.
'
'   * The sample tests assert INVARIANTS rather than the fixture-specific
'     constants ("CustomControlsPackage", 22 files, 7 directories) that the
'     Python version checks. Those only hold for one particular file. The
'     observed name and counts are printed as [INFO] instead.
'
'   * Each test parses its own copy of the sample rather than sharing state,
'     so a failure in one cannot cascade into a misleading failure or a null
'     object reference in another.
'
'   Usage:
'   impexp --self-test [path-to-a-.twinproj-or-.twinpack]

Private Module modSelfTest

    Option Explicit

    Private mPassed As Long
    Private mFailed As Long
    Private mSkipped As Long

    Private mTmpDir As String
    Private mSamplePath As String
    Private mHasSample As Boolean
    Private mSampleBuf() As Byte
    Private mSampleLen As Long

    ' ---------------------------------------------------------- assertions

    Private Sub AssertEqL(ByVal actual As Long, ByVal expected As Long, ByVal msg As String)
        If actual <> expected Then
            Err.Raise vbObjectError + 2000, "SelfTest", _
                      msg & ": expected " & CStr(expected) & ", got " & CStr(actual)
        End If
    End Sub

    Private Sub AssertEqS(ByVal actual As String, ByVal expected As String, ByVal msg As String)
        If actual <> expected Then
            Err.Raise vbObjectError + 2000, "SelfTest", _
                      msg & ": expected """ & expected & """, got """ & actual & """"
        End If
    End Sub

    Private Sub AssertTrue(ByVal cond As Boolean, ByVal msg As String)
        If Not cond Then
            Err.Raise vbObjectError + 2000, "SelfTest", msg
        End If
    End Sub

    Private Sub Fail(ByVal msg As String)
        Err.Raise vbObjectError + 2000, "SelfTest", msg
    End Sub

    Private Sub Info(ByVal msg As String)
        Say "  [INFO] " & msg
    End Sub

    ' ------------------------------------------------------------- helpers

    Private Function BytesEqual(ByRef a() As Byte, ByVal na As Long, _
                                ByRef b() As Byte, ByVal nb As Long) As Boolean
        If na <> nb Then Return False
        Dim i As Long
        For i = 0 To na - 1
            If a(i) <> b(i) Then Return False
        Next
        Return True
    End Function

    Private Function EntryContentEqual(ByVal x As Entry, ByVal y As Entry) As Boolean
        If x.ContentLen <> y.ContentLen Then Return False
        Dim i As Long
        For i = 0 To x.ContentLen - 1
            If x.ContentByte(i) <> y.ContentByte(i) Then Return False
        Next
        Return True
    End Function

    Private Sub FlattenTree(ByVal e As Entry, ByVal prefix As String, _
                            ByVal paths As Collection, ByVal entries As Collection)
        If e.Kind = ekFile Then
            paths.Add prefix & e.Name
            entries.Add e
        Else
            Dim i As Long
            For i = 1 To e.Children.Count
                FlattenTree e.Children.Item(i), prefix & e.Name & "/", paths, entries
            Next
        End If
    End Sub

    Private Sub WalkDisk(ByVal dirPath As String, ByVal prefix As String, ByVal paths As Collection)
        Dim names() As String, isDir() As Boolean, count As Long, i As Long
        ListDirectory dirPath, names, isDir, count

        Dim dirs() As String, files() As String
        Dim nd As Long, nf As Long
        ReDim dirs(0 To IIf(count = 0, 0, count - 1))
        ReDim files(0 To IIf(count = 0, 0, count - 1))

        For i = 0 To count - 1
            If isDir(i) Then
                dirs(nd) = names(i)
                nd = nd + 1
            Else
                files(nf) = names(i)
                nf = nf + 1
            End If
        Next
        SortStrings dirs, nd
        SortStrings files, nf

        For i = 0 To nd - 1
            WalkDisk JoinPath(dirPath, dirs(i)), prefix & dirs(i) & "/", paths
        Next
        For i = 0 To nf - 1
            paths.Add prefix & files(i)
        Next
    End Sub

    Private Sub CountTree(ByVal e As Entry, ByRef fileCount As Long, ByRef dirCount As Long)
        If e.Kind = ekFile Then
            fileCount = fileCount + 1
        Else
            dirCount = dirCount + 1
            Dim i As Long
            For i = 1 To e.Children.Count
                CountTree e.Children.Item(i), fileCount, dirCount
            Next
        End If
    End Sub

    Private Sub CountRoot(ByVal root As Entry, ByRef fileCount As Long, ByRef dirCount As Long)
        fileCount = 0
        dirCount = 0
        Dim i As Long
        For i = 1 To root.Children.Count
            CountTree root.Children.Item(i), fileCount, dirCount
        Next
    End Sub

    ' Writes a minimal but valid-looking project tree on disk under the given
    ' name and returns its full path. Includes a top-level "Settings" FILE
    ' (its real on-disk form) so DoExport's Settings guard is satisfied. Used
    ' by the guard tests and available to any future disk test that needs a
    ' packable tree without depending on the sample.
    Private Function MakeProjectTree(ByVal name As String, ByVal withSettings As Boolean) As String
        Dim d As String
        d = JoinPath(mTmpDir, name)
        EnsureDirectory d

        Dim body() As Byte, n As Long
        Utf8Encode "Public Sub Main()" & vbCrLf & "End Sub", body, n
        WriteWholeFile JoinPath(d, "Module1.twin"), body, n

        If withSettings Then
            Dim sbody() As Byte, sn As Long
            Utf8Encode "[Settings]" & vbCrLf & "Name=" & name, sbody, sn
            WriteWholeFile JoinPath(d, "Settings"), sbody, sn
        End If

        Return d
    End Function

    ' ------------------------------------------- tests requiring a sample

    ' Invariants that hold for ANY well-formed file, plus a re-parse
    ' consistency check. The observed shape is reported, not asserted.
    Private Sub T_ParseSample()
        Dim root As Entry
        Set root = ParseBuffer(mSampleBuf, mSampleLen)

        AssertTrue Len(root.Name) > 0, "root name is empty"
        AssertEqL root.Kind, ekDirectory, "root kind"

        Dim fc As Long, dc As Long
        CountRoot root, fc, dc

        ' The tree must survive a serialize/re-parse with identical shape.
        Dim buf() As Byte, n As Long
        buf = SerializeTree(root, n)
        Dim root2 As Entry
        Set root2 = ParseBuffer(buf, n)

        AssertEqS root2.Name, root.Name, "root name after re-parse"
        Dim fc2 As Long, dc2 As Long
        CountRoot root2, fc2, dc2
        AssertEqL fc2, fc, "file count after re-parse"
        AssertEqL dc2, dc, "dir count after re-parse"

        Info "root """ & root.Name & """, " & CStr(fc) & " files, " & _
             CStr(dc) & " directories, " & CStr(mSampleLen) & " bytes"
    End Sub

    ' Parses its own copy -- does not depend on T_ParseSample having run.
    Private Sub T_InMemoryRoundTrip()
        Dim root As Entry
        Set root = ParseBuffer(mSampleBuf, mSampleLen)

        Dim buf2() As Byte, len2 As Long
        buf2 = SerializeTree(root, len2)

        Dim root2 As Entry
        Set root2 = ParseBuffer(buf2, len2)

        Dim p1 As New Collection, e1 As New Collection
        Dim p2 As New Collection, e2 As New Collection
        FlattenTree root, "", p1, e1
        FlattenTree root2, "", p2, e2

        AssertEqL p1.Count, p2.Count, "file count"
        Dim i As Long
        For i = 1 To p1.Count
            AssertEqS CStr(p1.Item(i)), CStr(p2.Item(i)), "path[" & CStr(i) & "]"
            If Not EntryContentEqual(e1.Item(i), e2.Item(i)) Then
                Fail "content mismatch: " & CStr(p1.Item(i))
            End If
        Next
    End Sub

    Private Sub T_Idempotence()
        Dim once() As Byte, onceLen As Long
        Dim twice() As Byte, twiceLen As Long

        once = SerializeTree(ParseBuffer(mSampleBuf, mSampleLen), onceLen)
        twice = SerializeTree(ParseBuffer(once, onceLen), twiceLen)

        If Not BytesEqual(once, onceLen, twice, twiceLen) Then
            Fail CStr(onceLen) & " vs " & CStr(twiceLen) & " bytes (or differing content)"
        End If
    End Sub

    ' Sample-driven. Exports the imported sample WITHOUT opting out of the
    ' Settings guard -- so this doubles as real-world coverage that a genuine
    ' project (which has a Settings entry) packs cleanly. If this fails with
    ' IE_ERR_NO_SETTINGS, the sample lacks a top-level Settings entry, which
    ' would itself be worth knowing.
    Private Sub T_DiskRoundTrip()
        Dim dir1 As String, dir2 As String, rtFile As String
        dir1 = JoinPath(mTmpDir, "import1")
        dir2 = JoinPath(mTmpDir, "import2")
        rtFile = JoinPath(mTmpDir, "roundtrip.bin")

        DoImport mSamplePath, dir1, True
        DoExport dir1, rtFile, True
        DoImport rtFile, dir2, True

        Dim a As New Collection, b As New Collection
        WalkDisk dir1, "", a
        WalkDisk dir2, "", b
        AssertEqL a.Count, b.Count, "file count"

        Dim i As Long
        Dim ba() As Byte, na As Long
        Dim bb() As Byte, nb As Long
        For i = 1 To a.Count
            AssertEqS CStr(a.Item(i)), CStr(b.Item(i)), "path[" & CStr(i) & "]"
            ReadWholeFile JoinPath(dir1, Replace$(CStr(a.Item(i)), "/", "\")), ba, na
            ReadWholeFile JoinPath(dir2, Replace$(CStr(b.Item(i)), "/", "\")), bb, nb
            If Not BytesEqual(ba, na, bb, nb) Then
                Fail "content mismatch: " & CStr(a.Item(i))
            End If
        Next
    End Sub

    ' ------------------------------------------------------ synthetic tests

    Private Sub T_EmptyProject()
        Dim tree As Entry
        Set tree = New Entry
        tree.Kind = ekDirectory
        tree.Name = "Empty"

        Dim buf() As Byte, n As Long
        buf = SerializeTree(tree, n)

        Dim rt As Entry
        Set rt = ParseBuffer(buf, n)
        AssertEqS rt.Name, "Empty", "name"
        AssertEqL rt.Children.Count, 0, "children"
    End Sub

    Private Sub T_SingleFile()
        Dim content() As Byte
        Dim contentLen As Long
        Utf8Encode "Hello twinBASIC", content, contentLen

        Dim f As Entry
        Set f = New Entry
        f.Kind = ekFile
        f.Name = "test.twin"
        f.Revision = 2
        f.SetContent content, contentLen
        f.AllocRevisions 0

        Dim tree As Entry
        Set tree = New Entry
        tree.Kind = ekDirectory
        tree.Name = "Mini"
        tree.Children.Add f

        Dim buf() As Byte, n As Long
        buf = SerializeTree(tree, n)

        Dim rt As Entry
        Set rt = ParseBuffer(buf, n)
        AssertEqL rt.Children.Count, 1, "children"

        Dim got As Entry
        Set got = rt.Children.Item(1)
        AssertEqS got.Name, "test.twin", "filename"
        If Not EntryContentEqual(got, f) Then Fail "content mismatch"
    End Sub

    Private Sub T_FlagsPreserved()
        Dim f As Entry
        Set f = New Entry
        f.Kind = ekFile
        f.Name = "h.twin"
        f.Revision = 2
        f.Flags = IE_FLAGS_HIDDEN Or IE_FLAGS_VIRTUAL
        Dim one(0 To 0) As Byte
        one(0) = Asc("x")
        f.SetContent one, 1
        f.AllocRevisions 0

        Dim tree As Entry
        Set tree = New Entry
        tree.Kind = ekDirectory
        tree.Name = "WithFlags"
        tree.Flags = IE_FLAGS_HIDDEN
        tree.Children.Add f

        Dim buf() As Byte, n As Long
        buf = SerializeTree(tree, n)

        Dim rt As Entry
        Set rt = ParseBuffer(buf, n)
        AssertEqL rt.Flags, IE_FLAGS_HIDDEN, "root flags"
        AssertEqL rt.Children.Item(1).Flags, IE_FLAGS_HIDDEN Or IE_FLAGS_VIRTUAL, "file flags"
    End Sub

    ' Unicode names and content survive the UTF-8 layer, and the ordinal
    ' sort is exercised by names that a case-insensitive compare would
    ' order differently.
    Private Sub T_UnicodeAndOrdering()
        Dim tree As Entry
        Set tree = New Entry
        tree.Kind = ekDirectory
        tree.Name = "Ordering"

        Dim names(0 To 3) As String
        names(0) = "Zebra.twin"
        names(1) = "apple.twin"
        names(2) = ChrW$(&H00E9) & "clair.twin"      ' e-acute
        names(3) = ChrW$(&H65E5) & ChrW$(&H672C) & ".twin"  ' CJK

        Dim i As Long
        Dim body() As Byte, bodyLen As Long
        For i = 0 To 3
            Dim f As Entry
            Set f = New Entry
            f.Kind = ekFile
            f.Name = names(i)
            f.Revision = 2
            Utf8Encode "content " & names(i), body, bodyLen
            f.SetContent body, bodyLen
            f.AllocRevisions 0
            tree.Children.Add f
        Next

        Dim buf() As Byte, n As Long
        buf = SerializeTree(tree, n)

        Dim rt As Entry
        Set rt = ParseBuffer(buf, n)
        AssertEqL rt.Children.Count, 4, "children"
        For i = 0 To 3
            AssertEqS rt.Children.Item(i + 1).Name, names(i), "name[" & CStr(i) & "]"
        Next

        ' Ordinal sort must put uppercase Z before lowercase a.
        Dim s(0 To 1) As String
        s(0) = "apple"
        s(1) = "Zebra"
        SortStrings s, 2
        AssertEqS s(0), "Zebra", "ordinal sort places uppercase first"
    End Sub

    Private Sub T_BadMagicRejected()
        Dim junk() As Byte
        Dim n As Long
        Utf8Encode "not a twinpack!!", junk, n

        On Error GoTo Caught
        ParseBuffer junk, n
        On Error GoTo 0
        Fail "should have thrown"
        Exit Sub
Caught:
        If InStr(Err.Description, "Bad magic") = 0 Then
            Fail "wrong error: " & Err.Description
        End If
    End Sub

    Private Sub T_TruncationRejected()
        Dim tree As Entry
        Set tree = New Entry
        tree.Kind = ekDirectory
        tree.Name = "Trunc"

        Dim buf() As Byte, n As Long
        buf = SerializeTree(tree, n)

        On Error GoTo Caught
        ParseBuffer buf, n - 1        ' claim the file is one byte shorter
        On Error GoTo 0
        Fail "should have thrown"
        Exit Sub
Caught:
        If InStr(Err.Description, "Truncated") = 0 Then
            Fail "wrong error: number=0x" & Hex$(Err.Number) & _
                 " source=""" & Err.Source & """ desc=""" & Err.Description & """"
        End If
    End Sub

    ' Builds a real on-disk tree whose deepest file path exceeds the legacy
    ' 260-char limit, exports it, and re-imports it. Self-validating: the
    ' fixture cannot even be created unless the long-path code works, and a
    ' capped chokepoint anywhere raises rather than silently truncating.
    '
    ' Uses the disk, so it is grouped with the sample tests' need for a temp
    ' dir -- but needs no sample, so it runs unconditionally. Opts out of the
    ' Settings guard: this fixture tests path length, not project validity.
    Private Sub T_LongPath()
        ' A chain of 40-char directory segments. Six levels puts the leaf
        ' file comfortably past 260 even from a short temp root.
        Dim seg As String
        seg = String$(40, "a")

        Dim deep As String
        deep = JoinPath(mTmpDir, "longpath")
        Dim i As Long
        For i = 1 To 6
            deep = JoinPath(deep, seg)
        Next
        EnsureDirectory deep

        ' Sanity: confirm we actually crossed the boundary, so a future
        ' change to the segment math can't quietly make this a short-path
        ' test that always passes.
        Dim leaf As String
        leaf = JoinPath(deep, "payload.twin")
        AssertTrue Len(leaf) > 260, _
                   "fixture path only " & CStr(Len(leaf)) & " chars -- not testing long paths"

        Dim body() As Byte, bodyLen As Long
        Utf8Encode "deep content", body, bodyLen
        WriteWholeFile leaf, body, bodyLen

        ' Export the top of the deep tree, then re-import it elsewhere.
        Dim srcRoot As String, packFile As String, dstRoot As String
        srcRoot = JoinPath(mTmpDir, "longpath")
        packFile = JoinPath(mTmpDir, "longpath.bin")
        dstRoot = JoinPath(mTmpDir, "longpath-out")

        DoExport srcRoot, packFile, True, requireSettings:=False
        DoImport packFile, dstRoot, True

        ' Walk down the re-imported copy to the same leaf and check bytes.
        Dim reLeaf As String
        reLeaf = dstRoot
        For i = 1 To 6
            reLeaf = JoinPath(reLeaf, seg)
        Next
        reLeaf = JoinPath(reLeaf, "payload.twin")

        AssertTrue PathExists(reLeaf), "re-imported leaf missing: " & reLeaf

        Dim got() As Byte, gotLen As Long
        ReadWholeFile reLeaf, got, gotLen
        If Not BytesEqual(body, bodyLen, got, gotLen) Then
            Fail "long-path content mismatch"
        End If
    End Sub

    ' The Settings guard must REFUSE to pack a tree with no top-level Settings
    ' entry, because the resulting file opens with references, project name,
    ' and version blanked -- verified data loss. Builds a Settings-less tree
    ' and asserts DoExport raises IE_ERR_NO_SETTINGS and writes nothing.
    Private Sub T_SettingsGuardFires()
        Dim d As String
        d = MakeProjectTree("no-settings", False)     ' withSettings = False

        Dim outFile As String
        outFile = JoinPath(mTmpDir, "no-settings.twinproj")

        On Error GoTo Caught
        ' Default requireSettings:=True -- the guard should fire.
        DoExport d, outFile, True
        On Error GoTo 0
        Fail "DoExport should have refused a tree with no Settings"
        Exit Sub
Caught:
        If Err.Number <> IE_ERR_NO_SETTINGS Then
            Fail "wrong error: 0x" & Hex$(Err.Number) & " " & Err.Description
        End If
        ' The guard must abort BEFORE writing -- no partial file left behind.
        If PathExists(outFile) Then
            Fail "guard fired but a partial file was left on disk: " & outFile
        End If
    End Sub

    ' The complement: with a Settings entry present (as a FILE, its real
    ' on-disk form), the guard must NOT fire and the pack must succeed. Also
    ' covers the file-vs-directory point -- an earlier check looked only for a
    ' Settings *directory* and false-fired on the file form.
    Private Sub T_SettingsGuardPassesWithFile()
        Dim d As String
        d = MakeProjectTree("with-settings", True)     ' withSettings = True

        Dim outFile As String
        outFile = JoinPath(mTmpDir, "with-settings.twinproj")

        ' Should succeed without raising. Default requireSettings:=True.
        DoExport d, outFile, True
        AssertTrue PathExists(outFile), "pack with Settings present did not produce a file"
    End Sub
    
    ' The export overwrite guard must refuse an existing output file by
    ' default, and must proceed when overwrite:=True. The .twinproj is the
    ' source of truth -- unlike an unpacked tree it cannot be regenerated --
    ' so clobbering it silently would be real data loss.
    Private Sub T_OverwriteGuardFires()
        Dim d As String
        d = MakeProjectTree("ow-src", True)          ' has Settings, so it packs

        Dim outFile As String
        outFile = JoinPath(mTmpDir, "ow.twinproj")

        ' First pack creates the file.
        DoExport d, outFile, True
        AssertTrue PathExists(outFile), "first pack did not produce a file"

        ' Second pack, default overwrite:=False, must refuse.
        On Error GoTo Caught
        DoExport d, outFile, True
        On Error GoTo 0
        Fail "DoExport should have refused to overwrite an existing file"
        Exit Sub
Caught:
        If Err.Number <> IE_ERR_TARGET_EXISTS Then
            Fail "wrong error: 0x" & Hex$(Err.Number) & " " & Err.Description
        End If
    End Sub

    ' The complement: overwrite:=True must replace an existing file without
    ' raising.
    Private Sub T_OverwritePassesWithFlag()
        Dim d As String
        d = MakeProjectTree("ow2-src", True)

        Dim outFile As String
        outFile = JoinPath(mTmpDir, "ow2.twinproj")

        DoExport d, outFile, True                     ' create
        DoExport d, outFile, True, overwrite:=True     ' replace -- must not raise
        AssertTrue PathExists(outFile), "overwrite pack did not produce a file"
    End Sub

    ' cleanFirst must empty the target before unpacking, so files left from a
    ' previous unpack do not survive. Also checks the complement: a stray file
    ' present WITHOUT cleanFirst survives (proving the clean is what removed
    ' it, not something else).
    Private Sub T_CleanFirstRemovesStale()
        ' Build a tiny pack to unpack from.
        Dim src As String
        src = MakeProjectTree("clean-src", True)
        Dim packFile As String
        packFile = JoinPath(mTmpDir, "clean.twinproj")
        DoExport src, packFile, True

        Dim target As String
        target = JoinPath(mTmpDir, "clean-target")

        ' First unpack, then plant a stray file that the pack does not contain.
        DoImport packFile, target, True
        Dim junk() As Byte, jn As Long
        Utf8Encode "stale", junk, jn
        Dim strayPath As String
        strayPath = JoinPath(target, "STRAY_LEFTOVER.txt")
        WriteWholeFile strayPath, junk, jn
        AssertTrue PathExists(strayPath), "could not plant stray file"

        ' Unpack again WITHOUT cleanFirst -- stray should survive.
        DoImport packFile, target, True
        AssertTrue PathExists(strayPath), "stray vanished without cleanFirst (unexpected)"

        ' Unpack again WITH cleanFirst -- stray must be gone.
        DoImport packFile, target, True, cleanFirst:=True
        AssertTrue Not PathExists(strayPath), "cleanFirst did not remove the stray file"
    End Sub

    ' cleanFirst must refuse a dangerously shallow target rather than
    ' recursively deleting it. Uses a fabricated shallow path; the guard
    ' fires on PathDepth, so no actual delete is attempted.
    /*
    Private Sub T_CleanFirstDepthGuard()
        ' A depth-1 path: drive root plus one segment. PathDepth = 1 < 2, so
        ' the guard must fire. This directory need not exist as far as the
        ' depth check is concerned, but DoImport only cleans if IsDirectory is
        ' true -- so point at a real shallow dir we create and then leave.
        ' Use the drive of the temp dir to stay on a valid volume.
        Dim drive As String
        drive = Left$(AbsPath(mTmpDir), 2)            ' e.g. "C:"
        Dim shallow As String
        shallow = drive & "\impexp_depthguard_probe"

        ' We do NOT create it -- IsDirectory is false, so DoImport would skip
        ' cleaning entirely and the guard would not be exercised. To actually
        ' hit the guard, create it, and rely on the guard to prevent deletion.
        EnsureDirectory shallow

        Dim packFile As String
        Dim src As String
        src = MakeProjectTree("depth-src", True)
        packFile = JoinPath(mTmpDir, "depth.twinproj")
        DoExport src, packFile, True

        On Error GoTo Caught
        DoImport packFile, shallow, True, cleanFirst:=True
        On Error GoTo 0
        ' If we reach here the guard did NOT fire -- clean up and fail.
        On Error Resume Next
        DeleteTree shallow
        On Error GoTo 0
        Fail "cleanFirst should have refused a shallow (depth 1) target"
        Exit Sub
Caught:
        Dim wasGuard As Boolean
        wasGuard = (InStr(Err.Description, "shallow") > 0)
        ' Clean up the probe dir regardless.
        On Error Resume Next
        DeleteTree shallow
        On Error GoTo 0
        If Not wasGuard Then
            Fail "wrong error: 0x" & Hex$(Err.Number) & " " & Err.Description
        End If
    End Sub
    */
    
    ' The clean-first depth guard rests entirely on PathDepth, so test that
    ' function directly rather than exercising a real recursive delete on a
    ' shallow directory (which would mean creating a folder at a drive root).
    ' Pure and side-effect-free: it asserts the segment-counting that the
    ' guard's "< 2" threshold depends on. If these values are right, the
    ' guard refuses drive roots and single-level folders and permits normal
    ' project paths.
    Private Sub T_PathDepthGuard()
        ' Drive-letter paths. Depth is segments below the drive root.
        AssertEqL PathDepth("C:\"), 0, "drive root depth"
        AssertEqL PathDepth("C:\Downloads"), 1, "single-level depth"
        AssertEqL PathDepth("C:\Users\me\proj"), 3, "three-level depth"

        ' Trailing separator must not change the count.
        AssertEqL PathDepth("C:\Users\me\proj\"), 3, "trailing-sep depth"

        ' The guard's threshold: < 2 is refused, >= 2 is allowed.
        AssertTrue PathDepth("C:\") < 2, "drive root must be refused"
        AssertTrue PathDepth("C:\Downloads") < 2, "single-level must be refused"
        AssertTrue PathDepth("C:\a\b") >= 2, "two-level must be allowed"

        ' UNC: depth is measured below the share root, so \\server\share is 0.
        AssertEqL PathDepth("\\server\share"), 0, "UNC share root depth"
        AssertEqL PathDepth("\\server\share\proj"), 1, "UNC one-level depth"
        AssertEqL PathDepth("\\server\share\a\b"), 2, "UNC two-level depth"
    End Sub

    ' ------------------------------------------------------------- runner

    Private Sub RunTest(ByVal id As Long, ByVal name As String, ByVal needsSample As Boolean)
        If needsSample And Not mHasSample Then
            Say "  [SKIP] " & name
            mSkipped = mSkipped + 1
            Exit Sub
        End If

        On Error GoTo Failed
        Select Case id
            Case 1:  T_ParseSample
            Case 2:  T_InMemoryRoundTrip
            Case 3:  T_Idempotence
            Case 4:  T_DiskRoundTrip
            Case 5:  T_EmptyProject
            Case 6:  T_SingleFile
            Case 7:  T_FlagsPreserved
            Case 8:  T_UnicodeAndOrdering
            Case 9:  T_BadMagicRejected
            Case 10: T_TruncationRejected
            Case 11: T_LongPath
            Case 12: T_SettingsGuardFires
            Case 13: T_SettingsGuardPassesWithFile
            Case 14: T_OverwriteGuardFires
            Case 15: T_OverwritePassesWithFlag
            Case 16: T_CleanFirstRemovesStale
            Case 17: T_PathDepthGuard
        End Select
        Say "  [PASS] " & name
        mPassed = mPassed + 1
        Exit Sub
Failed:
        Say "  [FAIL] " & name
        Say "         " & Err.Description
        mFailed = mFailed + 1
    End Sub

    ' samplePath may be "" -- the sample-driven tests are then skipped.
    ' A supplied-but-missing path is an error, since it is almost certainly
    ' a typo rather than an intentional omission.
    Public Function RunSelfTest(ByVal samplePath As String) As Long
        mPassed = 0
        mFailed = 0
        mSkipped = 0
        mSamplePath = samplePath
        mHasSample = False

        If Len(samplePath) > 0 Then
            If Not PathExists(samplePath) Then
                Say "Sample not found: " & samplePath
                Return 1
            End If
            ReadWholeFile samplePath, mSampleBuf, mSampleLen
            mHasSample = True
        End If

        mTmpDir = JoinPath(Environ$("TEMP"), "impexp-test-" & CStr(CLng(Timer * 1000)))
        EnsureDirectory mTmpDir
        Say "Self-test  workdir: " & mTmpDir
        If mHasSample Then
            Say "Sample:            " & samplePath
        Else
            Say "Sample:            (none supplied -- sample tests will be skipped)"
        End If
        Say ""

        RunTest 1, "Parse sample (invariants + re-parse consistency)", True
        RunTest 2, "In-memory round-trip (parse -> serialize -> re-parse)", True
        RunTest 3, "Serializer idempotence (double round-trip)", True
        RunTest 4, "Disk round-trip (import -> export -> re-import)", True
        RunTest 5, "Empty project round-trip", False
        RunTest 6, "Single-file project round-trip", False
        RunTest 7, "Flags field preserved on round-trip", False
        RunTest 8, "Unicode names and ordinal ordering", False
        RunTest 9, "Bad magic rejected", False
        RunTest 10, "Truncated input rejected", False
        RunTest 11, "Long path (>260 chars) round-trip", False
        RunTest 12, "Settings guard refuses tree with no Settings", False
        RunTest 13, "Settings guard passes with Settings file present", False
        RunTest 14, "Export overwrite guard refuses existing file", False
        RunTest 15, "Export overwrite proceeds with overwrite flag", False
        RunTest 16, "Clean-first removes stale files", False
        RunTest 17, "Clean-first depth guard (PathDepth logic)", False

        On Error Resume Next
        DeleteTree mTmpDir
        On Error GoTo 0

        Say ""
        Dim summary As String
        summary = CStr(mPassed) & "/" & CStr(mPassed + mFailed) & " tests passed"
        If mSkipped > 0 Then
            summary = summary & " (" & CStr(mSkipped) & " skipped -- pass a " & _
                      ".twinproj or .twinpack path to run them)"
        End If
        Say summary & "."

        If mFailed > 0 Then Return 1
        Return 0
    End Function

End Module
