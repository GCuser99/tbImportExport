' ==========================================================================
' MergeTextFilesTests
'
' Targets ONE failure mode: MergeTextFiles decides whether it is doing an in-place
' merge by comparing the output path against the input paths TEXTUALLY. If the
' same file is named two different ways - "a.txt" vs ".\a.txt" vs an absolute
' path - the comparison misses, the temp-swap is skipped, and CreateTextFile
' (CREATE_ALWAYS) TRUNCATES the first file before it has been read.
'
' The result is silent data loss: no error, and the output contains only the
' SECOND file's content. So every assertion here checks that the FIRST file's
' content survived - that is the thing that disappears.
'
' All cases live in a scratch folder under %TEMP% and clean up after themselves.
' The relative-path cases change the process CWD, which is saved and restored.
'
' EXPECTED BEFORE THE FIX: cases 1, 2 and 6 pass; 3, 4, 5 and 7 fail.
' EXPECTED AFTER:          all pass.
' ==========================================================================

Private Module MergeTextFilesTests
    Option Explicit

    Private Const A_TEXT As String = "A-line-1" & vbCrLf & "A-line-2"
    Private Const B_TEXT As String = "B-line-1" & vbCrLf & "B-line-2"

    Private mPassed As Long
    Private mFailed As Long
    Private mRoot As String
    Private mSavedCwd As String

    Public Sub RunAll()
        mPassed = 0
        mFailed = 0
        mSavedCwd = FileSystemTools.GetCurrentDir()
        mRoot = FileSystemTools.BuildPath( _
                    FileSystemTools.GetSpecialFolder(sfTemporaryFolder), "mergetests")

        Debug.Print "=== MergeTextFiles: path aliasing / in-place safety ==="

        On Error GoTo Done

        Case1_DistinctOutput
        Case2_OutputOmitted
        Case3_DotSlashAlias
        Case4_AbsoluteVsRelative
        Case5_RelativeVsAbsolute
        Case6_CaseDifference
        Case7_AliasesSecondFile
        Case8_ForwardSlashAlias
        Case9_NoStrayTempLeft

    Done:
        If Err.Number <> 0 Then
            Debug.Print "  HARNESS ERROR " & Err.Number & ": " & Err.Description
            mFailed = mFailed + 1
        End If
        On Error Resume Next
        FileSystemTools.SetCurrentDir mSavedCwd      ' restore BEFORE deleting the folder
        FileSystemTools.DeleteFolder mRoot, True, True
        On Error GoTo 0

        Debug.Print vbCrLf & "=== " & mPassed & " passed, " & mFailed & " failed ==="
        If mFailed > 0 Then
            Debug.Print "*** A failure here means the FIRST file's content was destroyed."
        End If
    End Sub

    '======================================================================
    ' Cases
    '
    ' Each one seeds a fresh pair of files, merges, and checks the result.
    ' The only thing that varies is HOW the output path names the target.
    '======================================================================

    ' Control: a genuinely separate output file. No aliasing, no temp-swap.
    Private Sub Case1_DistinctOutput()
        Dim a As String, b As String, o As String
        Seed a, b
        o = FileSystemTools.BuildPath(mRoot, "out.txt")
        FileSystemTools.MergeTextFiles a, b, o
        CheckMerged "1 distinct output path", o
    End Sub

    ' The in-place case that already worked: outputFilePath omitted, so outPath is
    ' assigned from firstFilePath and compares equal by construction.
    Private Sub Case2_OutputOmitted()
        Dim a As String, b As String
        Seed a, b
        FileSystemTools.MergeTextFiles a, b
        CheckMerged "2 output omitted (in place)", a
    End Sub

    ' THE BUG. ".\a.txt" and the absolute path are the same file, but StrComp says
    ' they differ, so inPlace is False and a.txt is truncated before it is read.
    Private Sub Case3_DotSlashAlias()
        Dim a As String, b As String
        Seed a, b
        FileSystemTools.SetCurrentDir mRoot
        FileSystemTools.MergeTextFiles "a.txt", "b.txt", ".\a.txt"
        FileSystemTools.SetCurrentDir mSavedCwd
        CheckMerged "3 output as '.\a.txt' vs 'a.txt'", a
    End Sub

    ' Same file, named relatively as input and absolutely as output.
    Private Sub Case4_AbsoluteVsRelative()
        Dim a As String, b As String
        Seed a, b
        FileSystemTools.SetCurrentDir mRoot
        FileSystemTools.MergeTextFiles "a.txt", "b.txt", a      ' a is absolute
        FileSystemTools.SetCurrentDir mSavedCwd
        CheckMerged "4 relative inputs, absolute output", a
    End Sub

    ' The mirror image: absolute input, relative output.
    Private Sub Case5_RelativeVsAbsolute()
        Dim a As String, b As String
        Seed a, b
        FileSystemTools.SetCurrentDir mRoot
        FileSystemTools.MergeTextFiles a, b, "a.txt"            ' output is relative
        FileSystemTools.SetCurrentDir mSavedCwd
        CheckMerged "5 absolute inputs, relative output", a
    End Sub

    ' Should already pass - StrComp uses vbTextCompare, so case alone does not
    ' defeat the check. Pinned so a later switch to vbBinaryCompare is caught.
    Private Sub Case6_CaseDifference()
        Dim a As String, b As String
        Seed a, b
        FileSystemTools.MergeTextFiles a, b, UCase$(a)
        CheckMerged "6 output differs only by case", a
    End Sub

    ' The OTHER alias direction: the output collides with the SECOND file, not the
    ' first. Here the truncation destroys b.txt instead, so the merged result loses
    ' its tail rather than its head - CheckMerged catches either.
    Private Sub Case7_AliasesSecondFile()
        Dim a As String, b As String
        Seed a, b
        FileSystemTools.SetCurrentDir mRoot
        FileSystemTools.MergeTextFiles "a.txt", "b.txt", ".\b.txt"
        FileSystemTools.SetCurrentDir mSavedCwd
        CheckMerged "7 output aliases the SECOND file", b
    End Sub

    ' Forward slashes are normalized on entry, but only AFTER (in the current code)
    ' the comparison would have been made against differently-spelled inputs.
    Private Sub Case8_ForwardSlashAlias()
        Dim a As String, b As String
        Seed a, b
        FileSystemTools.SetCurrentDir mRoot
        FileSystemTools.MergeTextFiles "a.txt", "b.txt", "./a.txt"
        FileSystemTools.SetCurrentDir mSavedCwd
        CheckMerged "8 output as './a.txt' (forward slash)", a
    End Sub

    ' Hygiene: an in-place merge must not strand its temp file. Also catches a
    ' fixed temp name that a later run would silently reuse.
    Private Sub Case9_NoStrayTempLeft()
        Dim a As String, b As String
        Seed a, b
        FileSystemTools.MergeTextFiles a, b                     ' in place -> uses a temp
        Dim leftovers As Collection
        Set leftovers = FileSystemTools.GetFilePaths(mRoot, "*.tmp*")
        Dim more As Collection
        Set more = FileSystemTools.GetFilePaths(mRoot, "*.mergetmp")
        Dim n As Long
        n = leftovers.Count + more.Count
        Check "9 no temp file left behind", (n = 0), "0 temp files", CStr(n) & " left"
    End Sub

    '======================================================================
    ' Helpers
    '======================================================================

    ' Fresh a.txt / b.txt in a fresh scratch folder. Recreating the folder each
    ' time means no case can be polluted by a previous one's leftovers.
    Private Sub Seed(ByRef aPath As String, ByRef bPath As String)
        FileSystemTools.DeleteFolder mRoot, True, True
        FileSystemTools.CreateFolder mRoot, True
        aPath = FileSystemTools.BuildPath(mRoot, "a.txt")
        bPath = FileSystemTools.BuildPath(mRoot, "b.txt")
        FileSystemTools.StringToTextFile A_TEXT, aPath, encUtf8, nlWindows
        FileSystemTools.StringToTextFile B_TEXT, bPath, encUtf8, nlWindows
    End Sub

    ' The merged file must contain BOTH halves, in order. Checking only the length
    ' or only the tail would miss the bug entirely - a truncated-then-rewritten
    ' file still looks like a plausible merge until you notice A is gone.
    Private Sub CheckMerged(ByVal name As String, ByVal resultPath As String)
        If Not FileSystemTools.FileExists(resultPath) Then
            Check name, False, "merged file", "file does not exist"
            Exit Sub
        End If

        Dim lines() As String
        lines = FileSystemTools.TextFileToArray(resultPath)
        If Not IsArrayInitialized(lines) Then
            Check name, False, "4 lines", "empty file"
            Exit Sub
        End If

        Dim got As String
        got = Join(lines, "|")

        Dim okA As Boolean, okB As Boolean, okOrder As Boolean
        okA = (InStr(got, "A-line-1") > 0) And (InStr(got, "A-line-2") > 0)
        okB = (InStr(got, "B-line-1") > 0) And (InStr(got, "B-line-2") > 0)
        okOrder = (InStr(got, "A-line-1") < InStr(got, "B-line-1")) And okA And okB

        If okA And okB And okOrder Then
            Check name, True, "", ""
        ElseIf Not okA Then
            ' The signature of the aliasing bug: the first file was truncated
            ' before it could be read.
            Check name, False, "A + B content", "FIRST FILE'S CONTENT LOST -> [" & got & "]"
        ElseIf Not okB Then
            Check name, False, "A + B content", "SECOND FILE'S CONTENT LOST -> [" & got & "]"
        Else
            Check name, False, "A before B", "out of order -> [" & got & "]"
        End If
    End Sub

    Private Sub Check(ByVal name As String, ByVal ok As Boolean, _
                      ByVal want As String, ByVal got As String)
        If ok Then
            mPassed = mPassed + 1
            Debug.Print "  PASS  " & name
        Else
            mFailed = mFailed + 1
            Debug.Print "  FAIL  " & name & "   want: " & want & "   got: " & got
        End If
    End Sub

End Module
