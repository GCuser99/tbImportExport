' ==========================================================================
' FsoParityTests
'
' Locks the path-parsing surface to Scripting.FileSystemObject. Every row below
' was captured from the real Scripting object and confirmed byte-identical to
' this library's output, so any future drift on GetFileName / GetBaseName /
' GetExtensionName / GetParentFolderName / GetDriveName / BuildPath fails here.
'
'   * Uses the twinBASIC "Assert" package, like the rest of the suite.
'   * Empty expectations are checked with Len(actual) = 0 rather than
'     AreEqual "", so the vbNullString-vs-"" flavor can't cause a false failure
'     (the same trap that surfaced while building this table).
'
' Special Note: FSO's lexical routines echo back whatever slashes you feed them:
' GetParentFolderName("C:/a/b") returns C:/a in FSO - forward slashes and all -
' because they only split on the separator, never rewrite it. This library 
' normalizes "/" to "\" on the way in, so the same call returns "C:\a". 
' Output is always canonical Windows separators regardless of what the input mixed.
' So this represents a parity break although arguably cosmetic in function.
' ==========================================================================

Private Module FsoParityTests
    Option Explicit

    Public Sub RunParityTests()
        Test_FsoParity_Components
        Test_FsoParity_ParentDrive
        Test_FsoParity_BuildPath
        Test_FSO_Docs_Examples
        Debug.Print "FSO parity: all rows match Scripting.FileSystemObject."
    End Sub

    '----------------------------------------------------------------------
    ' GetFileName / GetBaseName / GetExtensionName
    '   input,                       file,         base,    ext
    '----------------------------------------------------------------------
    Public Sub Test_FsoParity_Components()
        Dim fso As New FileSystemObject
        CheckComp fso, "C:\foo\bar.txt", "bar.txt", "bar", "txt"
        CheckComp fso, "C:\foo", "foo", "foo", ""
        CheckComp fso, "C:\foo\", "foo", "foo", ""
        CheckComp fso, "C:\foo\\", "foo", "foo", ""
        CheckComp fso, "C:\", "", "", ""
        CheckComp fso, "C:", "", "", ""
        CheckComp fso, "C:foo", "foo", "foo", ""
        CheckComp fso, "\\server\share\folder", "folder", "folder", ""
        CheckComp fso, "\\server\share", "", "", ""
        CheckComp fso, "\\server\share\", "", "", ""
        CheckComp fso, "\\server", "", "", ""
        CheckComp fso, "\", "", "", ""
        CheckComp fso, "", "", "", ""
        CheckComp fso, ".", ".", "", ""
        CheckComp fso, "..", "..", ".", ""
        CheckComp fso, "a.b.c", "a.b.c", "a.b", "c"
        CheckComp fso, "a.", "a.", "a", ""
        CheckComp fso, ".gitignore", ".gitignore", "", "gitignore"
        CheckComp fso, "C:\my.folder\file", "file", "file", ""
        CheckComp fso, "C:\my.folder\", "my.folder", "my", "folder"
        CheckComp fso, "C:/foo/bar.txt", "bar.txt", "bar", "txt"
    End Sub
    
    Sub Test_FSO_Docs_Examples()
        ' https://learn.microsoft.com/en-us/office/vba/language/reference/user-interface-help/getabsolutepathname-method
        Dim fsoScript As New Scripting.FileSystemObject
        Dim fso As New FileSystemObject
        Debug.Assert fso.GetAbsolutePathName("c:") = fsoScript.GetAbsolutePathName("c:")
        Debug.Assert fso.GetAbsolutePathName("c:..") = fsoScript.GetAbsolutePathName("c:..")
        Debug.Assert fso.GetAbsolutePathName("c:.\may97") = fsoScript.GetAbsolutePathName("c:.\may97")
        Debug.Assert fso.GetAbsolutePathName("region1") = fsoScript.GetAbsolutePathName("region1")
        Debug.Assert fso.GetAbsolutePathName("c:....\mydocuments") = fsoScript.GetAbsolutePathName("c:....\mydocuments")
        Debug.Assert fso.GetAbsolutePathName("c:\") = fsoScript.GetAbsolutePathName("c:\")
    End Sub

    '----------------------------------------------------------------------
    ' GetParentFolderName / GetDriveName
    '   input,                       parent,           drive
    '----------------------------------------------------------------------
    Public Sub Test_FsoParity_ParentDrive()
        Dim fso As New FileSystemObject
        CheckPD fso, "C:\foo\bar", "C:\foo", "C:"
        CheckPD fso, "C:\foo", "C:\", "C:"
        CheckPD fso, "C:\foo\", "C:\", "C:"
        CheckPD fso, "C:\", "", "C:"
        CheckPD fso, "C:", "", "C:"
        CheckPD fso, "\\server\share\folder", "\\server\share", "\\server\share"
        CheckPD fso, "\\server\share", "", "\\server\share"
        CheckPD fso, "\\server\share\", "", "\\server\share"
        CheckPD fso, "\\server", "", ""
        CheckPD fso, "foo\bar", "foo", ""
        CheckPD fso, "bar", "", ""
        CheckPD fso, "", "", ""
        CheckPD fso, "C:/foo/bar", "C:\foo", "C:" '<- scripting.fso returns "C:/foo"
        CheckPD fso, "c:\Foo", "c:\", "c:"
    End Sub

    '----------------------------------------------------------------------
    ' BuildPath
    '   path,            name,      result
    '----------------------------------------------------------------------
    Public Sub Test_FsoParity_BuildPath()
        Dim fso As New FileSystemObject
        CheckBuild fso, "C:\foo", "bar", "C:\foo\bar"
        CheckBuild fso, "C:\foo\", "bar", "C:\foo\bar"
        CheckBuild fso, "C:\foo", "\bar", "C:\foo\bar"
        CheckBuild fso, "C:\foo", "", "C:\foo"
        CheckBuild fso, "", "bar", "bar"
        CheckBuild fso, "C:", "foo", "C:foo"
        CheckBuild fso, "C:\", "foo", "C:\foo"
        CheckBuild fso, "\\server\share", "x", "\\server\share\x"
        CheckBuild fso, "C:\foo", "..\bar", "C:\foo\..\bar"
        CheckBuild fso, "C:/foo", "bar", "C:\foo\bar" '<- scripting.fso returns "C:/foo\bar"
    End Sub

    '----------------------------------------------------------------------
    ' Row helpers
    '   On a failure the suite stops inside AssertPathEq; the offending input
    '   and the expected/actual values are visible in the Locals window (the
    '   p / a / b parameters of the Check* frame just above it).
    '----------------------------------------------------------------------
    Private Sub CheckComp(ByVal fso As FileSystemObject, ByVal p As String, _
                          ByVal fileExp As String, ByVal baseExp As String, ByVal extExp As String)
        AssertPathEq fileExp, fso.GetFileName(p)
        AssertPathEq baseExp, fso.GetBaseName(p)
        AssertPathEq extExp, fso.GetExtensionName(p)
    End Sub

    Private Sub CheckPD(ByVal fso As FileSystemObject, ByVal p As String, _
                        ByVal parentExp As String, ByVal driveExp As String)
        AssertPathEq parentExp, fso.GetParentFolderName(p)
        AssertPathEq driveExp, fso.GetDriveName(p)
    End Sub

    Private Sub CheckBuild(ByVal fso As FileSystemObject, ByVal a As String, _
                           ByVal b As String, ByVal expected As String)
        AssertPathEq expected, fso.BuildPath(a, b)
    End Sub

    ' Exact string compare, except an empty expectation is satisfied by any
    ' zero-length result ("" or vbNullString) so the BSTR flavor is irrelevant.
    Private Sub AssertPathEq(ByVal expected As String, ByVal actual As String)
        If Len(expected) = 0 Then
            Assert.Exact.IsTrue Len(actual) = 0
        Else
            Assert.Exact.AreEqual expected, actual
        End If
    End Sub

End Module