'==========================================================================
'  LONG-PATH SUITES  --  builds a >400-character tree in %TEMP%            
'==========================================================================


' ==========================================================================
' LongPathWriteTests
'
' Exercises the paths that the final round of \\?\ prefixing just enabled - the
' ones the oracle did NOT cover, because the oracle only ever READ a leaf that
' cmd had written. These tests make tbFileSysTools itself do the WRITING,
' NORMALIZING and MERGING on a >260-char path, which is where the three
' remaining gaps lived:
'
'   1. WriteStream's atomic swap  (SetFileAttributesW + MoveFileExW on filePath,
'                                  and on the even-longer tempPath)
'   2. NormalizeTextFile          (GetFileAttributesW attribute reads)
'   3. MergeTextFiles                 (in-place MoveFileExW swap)
'
' The fixture tree is built with tB's own CreateFolder, which is now long-path
' capable via ApiPath -> CreateDirectoryW. If the tree fails to build, THAT is the
' first finding (CreateFolder regressed), reported before anything else runs.
'
' Cleanup uses cmd 'rd' because a >260 tree cannot be removed reliably otherwise.
'
' Run RunAll. Self-contained; leaves nothing behind on success.
' ==========================================================================

Private Module LongPathWriteTests
    Option Explicit

    Private Const SEG As String = "seg_0123456789_abcdefghijkl"   ' 27 chars
    Private Const DEPTH As Long = 12                              ' > 340 chars past base

    Private mPassed As Long
    Private mFailed As Long
    Private mBase As String
    Private mDeep As String

    Public Sub RunAll()
        mPassed = 0
        mFailed = 0
        Debug.Print "=== Long-path (>260) write-path round trips ==="

        On Error GoTo Fatal

        mBase = FileSystemTools.BuildPath( _
                    FileSystemTools.GetSpecialFolder(sfTemporaryFolder), "lpwrite")

        ' --- Build the deep fixture with OUR now-long-path-capable CreateFolder ---
        CleanTree                                    ' remove any leftover from a prior run
        Dim i As Long
        mDeep = mBase
        For i = 1 To DEPTH
            mDeep = FileSystemTools.BuildPath(mDeep, SEG & Right$("00" & i, 2))
        Next i

        FileSystemTools.CreateFolder mDeep, True     ' createIntermediates:=True
        If Not LongFolderExists(mDeep) Then
            Debug.Print "  *** tB CreateFolder could not build the >260 tree (len " & _
                        Len(mDeep) & "). CreateFolder has regressed - stopping."
            mFailed = mFailed + 1
            GoTo Done
        End If
        Debug.Print "  Fixture built by tB CreateFolder: " & Len(mDeep) & " chars deep."
        Debug.Print ""

        Test_StringToTextFile_RoundTrip
        Test_ArrayToTextFile_RoundTrip
        Test_NormalizeTextFile
        Test_MergeTextFiles_InPlace
        Test_TempNameOverflow
        Test_Rename
        
        Test_DeleteFolderRecursive
        Test_GetFilePaths
        Test_AppendStream
        Test_CopyAndMove
        Test_FileObject


    Done:
        CleanTree
        Debug.Print vbCrLf & "=== " & mPassed & " passed, " & mFailed & " failed ==="
        If mFailed > 0 Then _
            Debug.Print "*** A failure here means a raw Win32 call site is missing its ApiPath prefix."
        Exit Sub

    Fatal:
        Debug.Print "  HARNESS ERROR " & Err.Number & ": " & Err.Description
        mFailed = mFailed + 1
        Resume Done
    End Sub

    '======================================================================
    ' Tests
    '======================================================================

    ' The headline case: WriteStream's atomic swap on a >260 target. Before the
    ' fix this failed at MoveFileExW/SetFileAttributesW - silently, because the
    ' temp file was written (Open is long-path capable) but the rename to the real
    ' name could not complete.
    ' Rename is the ONLY internal caller that passes a baseDirectory to
    ' GetAbsolutePathName - i.e. the only path that went through PathCombineW
    ' (shlwapi, hard-capped at 260, no \\?\ support). This is the regression guard
    ' for the lexical-join replacement. Note the base here is itself >260: Rename
    ' derives it as the parent of the source, which is the ~400-char fixture folder.
    
    ' The library's own recursive delete at length. CleanTree uses cmd 'rd', so
    ' without this, DeleteFolderRecursive never runs on a long path - and it had the
    ' subtlest edit of all (bare fullPath for recursion, ApiPath at each API call).
    ' Uses its own subtree so the shared fixture survives for later tests.
    Private Sub Test_DeleteFolderRecursive()
        Dim root As String, nested As String
        root = FileSystemTools.BuildPath(mDeep, "del_root")
        nested = FileSystemTools.BuildPath(root, "nested")
        FileSystemTools.CreateFolder nested, True

        Dim keep As String
        keep = FileSystemTools.BuildPath(root, "a.txt")
        FileSystemTools.StringToTextFile "x", keep, encUtf8
        FileSystemTools.StringToTextFile "y", FileSystemTools.BuildPath(nested, "b.txt"), encUtf8

        ' Read-only child: forces the force:=True SetFileAttributesW branch, which is
        ' a separate prefixed call from the delete itself.
        FileSystemTools.GetFile(keep).SetAttribute ReadOnly, True

        FileSystemTools.DeleteFolder root, True          ' force:=True

        Check "DeleteFolder recursive on long path", _
              Not LongFolderExists(root), "gone", "still present"
    End Sub

    ' Enumeration at length. This is the cFileName-under-\\?\ check: the enumerators
    ' search "\\?\folder\*", and on some Windows builds cFileName can come back as a
    ' full path rather than a bare leaf. If that happened, the returned paths would be
    ' malformed rather than merely wrong - so assert the SHAPE, not just the count.
    Private Sub Test_GetFilePaths()
        Dim d As String
        d = FileSystemTools.BuildPath(mDeep, "enum")
        FileSystemTools.CreateFolder d, True
        FileSystemTools.StringToTextFile "1", FileSystemTools.BuildPath(d, "one.txt"), encUtf8
        FileSystemTools.StringToTextFile "2", FileSystemTools.BuildPath(d, "two.txt"), encUtf8

        Dim got As Collection
        Set got = FileSystemTools.GetFilePaths(d, "*.txt")

        Dim ok As Boolean, first As String
        ok = (got.Count = 2)
        If ok Then
            first = got(1)
            ' Must be a normal absolute path: no \\?\ leaking out, no doubled prefix.
            ok = (InStr(first, "\\?\") = 0) AndAlso (Left$(first, 2) <> "\\") _
                 AndAlso FileSystemTools.FileExists(first)
        End If
        Check "GetFilePaths on long path", ok, "2 clean absolute paths", _
              got.Count & " item(s), first=[" & first & "]"
    End Sub

    ' TextStream append. MergeTextFiles exercised OpenWriteFresh; nothing has exercised
    ' OpenWriteAppend, whose CreateFileW (FILE_APPEND_DATA) is a separate prefixed
    ' call site.
    Private Sub Test_AppendStream()
        Dim p As String
        p = FileSystemTools.BuildPath(mDeep, "append.txt")
        FileSystemTools.StringToTextFile "first", p, encUtf8, nlWindows

        Dim ts As TextStream
        Set ts = FileSystemTools.OpenTextFile(p, ForAppending)
        ts.WriteLine ""
        ts.Write "second"
        ts.Close

        Dim got As String: got = FileSystemTools.TextFileToString(p)
        Check "TextStream append on long path", _
              (InStr(got, "first") > 0 AndAlso InStr(got, "second") > 0), _
              "first + second", "[" & Replace(got, vbCrLf, "|") & "]"
    End Sub

    ' CopyFile and MoveFile with BOTH ends long - CopyFileExW / MoveFileExW take two
    ' paths and each is prefixed independently, so a one-sided fix would pass a test
    ' that only made the source long.
    Private Sub Test_CopyAndMove()
        Dim a As String, b As String, c As String
        a = FileSystemTools.BuildPath(mDeep, "cm_src.txt")
        b = FileSystemTools.BuildPath(mDeep, "cm_copy.txt")
        c = FileSystemTools.BuildPath(mDeep, "cm_moved.txt")
        FileSystemTools.StringToTextFile "payload", a, encUtf8

        FileSystemTools.CopyFile a, b
        Dim copied As Boolean
        copied = FileSystemTools.FileExists(b) AndAlso _
                 (FileSystemTools.TextFileToString(b) = "payload")

        FileSystemTools.MoveFile b, c
        Check "CopyFile + MoveFile, both ends long", _
              copied AndAlso FileSystemTools.FileExists(c) _
              AndAlso Not FileSystemTools.FileExists(b), _
              "copied then moved", "copied=" & copied & " moved=" & FileSystemTools.FileExists(c)
    End Sub

    ' File object properties go through StatPath; attributes go through
    ' SetPathAttributes - the Shared member that was raising 76 before it was fixed.
    Private Sub Test_FileObject()
        Dim p As String
        p = FileSystemTools.BuildPath(mDeep, "obj.txt")
        FileSystemTools.StringToTextFile "1234567890", p, encUtf8

        Dim f As File
        Set f = FileSystemTools.GetFile(p)
        Dim sizeOk As Boolean: sizeOk = (f.Size = 10)
        Dim nameOk As Boolean: nameOk = (f.Name = "obj.txt")     ' bare leaf, not a full path

        f.SetAttribute Hidden, True
        Dim attrOk As Boolean: attrOk = f.HasAttribute(Hidden)
        f.SetAttribute Hidden, False

        Check "File object on long path", sizeOk AndAlso nameOk AndAlso attrOk, _
              "Size=10, Name=obj.txt, Hidden round-trips", _
              "size=" & f.Size & " name=[" & f.Name & "] attr=" & attrOk
    End Sub
    
    Private Sub Test_Rename()
        Dim src As String, dst As String, returned As String
        src = FileSystemTools.BuildPath(mDeep, "rename_me.txt")
        FileSystemTools.StringToTextFile "payload", src, encUtf8, nlWindows

        Dim e As Long, d As String
        On Error Resume Next
        returned = FileSystemTools.Rename(src, "renamed.txt")
        e = Err.Number: d = Err.Description          ' capture BEFORE anything else runs
        On Error GoTo 0

        If e <> 0 Then
            Check "Rename on long path", False, "renamed.txt", _
                  "raised " & e & " (" & d & ")"
            Exit Sub                                  ' no restore: CleanTree handles it
        End If

        dst = FileSystemTools.BuildPath(mDeep, "renamed.txt")
        Dim ok As Boolean
        ok = (StrComp(returned, dst, vbTextCompare) = 0) _
             AndAlso FileSystemTools.FileExists(dst) _
             AndAlso Not FileSystemTools.FileExists(src)

        Check "Rename on long path", ok, "renamed.txt exists, old gone", _
              "returned=[" & FileSystemTools.GetFileName(returned) & "] new=" & _
              FileSystemTools.FileExists(dst) & " old=" & FileSystemTools.FileExists(src)
    End Sub
    
    
    Private Sub Test_StringToTextFile_RoundTrip()
        Dim leaf As String
        leaf = FileSystemTools.BuildPath(mDeep, "written.txt")
        Const PAYLOAD As String = "hello from a long path"

        FileSystemTools.StringToTextFile PAYLOAD, leaf, encUtf8, nlWindows

        ' Read back through OUR reader (also long-path capable now).
        Dim got As String
        got = FileSystemTools.TextFileToString(leaf)

        Check "StringToTextFile round trip (" & Len(leaf) & " chars)", _
              (got = PAYLOAD), PAYLOAD, got
    End Sub

    ' ArrayToTextFile shares WriteStream, but exercises the Join/lineEnding path.
    Private Sub Test_ArrayToTextFile_RoundTrip()
        Dim leaf As String
        leaf = FileSystemTools.BuildPath(mDeep, "array.txt")

        Dim lines(0 To 2) As String
        lines(0) = "alpha": lines(1) = "beta": lines(2) = "gamma"
        FileSystemTools.ArrayToTextFile lines, leaf, encUtf8, nlWindows

        Dim back() As String
        back = FileSystemTools.TextFileToArray(leaf)

        Dim ok As Boolean
        ok = IsArrayInitialized(back)
        If ok Then ok = (UBound(back) = 2) AndAlso (back(0) = "alpha") _
                        AndAlso (back(2) = "gamma")
        Check "ArrayToTextFile round trip", ok, "alpha..gamma (3)", _
              IIf(IsArrayInitialized(back), Join(back, ","), "<empty>")
    End Sub

    ' NormalizeTextFile reads attributes via GetFileAttributesW (the two sites that
    ' needed prefixing) and rewrites via WriteStream. Write CRLF, normalize to LF,
    ' confirm it changed and re-read clean.
    Private Sub Test_NormalizeTextFile()
        Dim leaf As String
        leaf = FileSystemTools.BuildPath(mDeep, "normalize.txt")

        FileSystemTools.StringToTextFile "a" & vbCrLf & "b" & vbCrLf & "c", leaf, encUtf8, nlNoChange

        Dim changed As Boolean
        changed = FileSystemTools.NormalizeTextFile(leaf, encUtf8, nlUnix)   ' CRLF -> LF

        Dim got As String
        got = FileSystemTools.TextFileToString(leaf)     ' nlNoChange default: exact bytes

        Dim ok As Boolean
        ok = changed AndAlso (got = "a" & vbLf & "b" & vbLf & "c")
        Check "NormalizeTextFile on long path", ok, "changed + LF-joined", _
              "changed=" & changed & " got=[" & Replace(got, vbLf, "\n") & "]"
    End Sub

    ' MergeTextFiles' in-place swap: output path aliases the first input, so it goes
    ' through the temp-and-MoveFileExW path - the third prefixed site.
    Private Sub Test_MergeTextFiles_InPlace()
        Dim a As String, b As String
        a = FileSystemTools.BuildPath(mDeep, "merge_a.txt")
        b = FileSystemTools.BuildPath(mDeep, "merge_b.txt")

        FileSystemTools.StringToTextFile "A1" & vbCrLf & "A2", a, encUtf8, nlWindows
        FileSystemTools.StringToTextFile "B1" & vbCrLf & "B2", b, encUtf8, nlWindows

        ' outputFilePath omitted -> in-place into 'a' -> temp swap on a >260 path
        FileSystemTools.MergeTextFiles a, b

        Dim got As String
        got = FileSystemTools.TextFileToString(a)
        Dim ok As Boolean
        ok = (InStr(got, "A1") > 0) AndAlso (InStr(got, "B2") > 0) _
             AndAlso (InStr(got, "A1") < InStr(got, "B1"))
        Check "MergeTextFiles in-place on long path", ok, "A then B", _
              "[" & Replace(got, vbCrLf, "|") & "]"
    End Sub

    ' The nastiest length case: a target ITSELF under the limit whose temp name
    ' (target + ".~XXXX.tmp", ~13 chars) crosses it. Fails if tempPath was left
    ' unprefixed while filePath was prefixed. We build the leaf directly under mBase
    ' (shallower) so we can hit the 245-259 window precisely by padding the name.
    Private Sub Test_TempNameOverflow()
        Dim prefixLen As Long
        prefixLen = Len(mBase) + 1 + 4          ' mBase + "\" + ".txt"
        Dim padTarget As Long
        padTarget = 252 - prefixLen             ' aim for a ~252-char full path
        If padTarget < 1 Then
            Debug.Print "  SKIP  temp-overflow: base path too long to size a boundary leaf."
            Exit Sub
        End If

        Dim leaf As String
        leaf = FileSystemTools.BuildPath(mBase, String$(padTarget, "n") & ".txt")

        If Len(leaf) < 245 Or Len(leaf) > 259 Then
            Debug.Print "  SKIP  temp-overflow: leaf is " & Len(leaf) & _
                        " chars, not in the 245-259 window."
            Exit Sub
        End If

        FileSystemTools.StringToTextFile "boundary", leaf, encUtf8, nlWindows
        Dim got As String: got = FileSystemTools.TextFileToString(leaf)
        Check "temp-name overflow (" & Len(leaf) & "+13 chars)", (got = "boundary"), _
              "boundary", got
    End Sub

    '======================================================================
    ' Helpers
    '======================================================================

    Private Sub Check(ByVal name As String, ByVal ok As Boolean, _
                      ByVal want As String, ByVal got As String)
        If ok Then
            mPassed = mPassed + 1
            Debug.Print "  PASS  " & name
        Else
            mFailed = mFailed + 1
            Debug.Print "  FAIL  " & name & "   want: " & want & "   got: " & got
        End If
    End Sub

    ' \\?\-prefixed existence check - cannot use tB FolderExists as the fixture
    ' verifier since that is part of what we are testing.
    Private Function LongFolderExists(ByVal path As String) As Boolean
        Dim a As Long
        a = GetFileAttributesW(StrPtr("\\?\" & path))
        LongFolderExists = (a <> INVALID_FILE_ATTRIBUTES) And ((a And FILE_ATTRIBUTE_DIRECTORY) <> 0)
    End Function

    Private Sub CleanTree()
        On Error Resume Next
        Dim sh As Object
        Set sh = CreateObject("WScript.Shell")
        sh.Run "cmd /c rd /s /q ""\\?\" & mBase & """", 0, True   ' past-260 safe
        On Error GoTo 0
    End Sub

End Module
